	FastTrigger: {
		// Tooltip: ""
		// DisplayName: Fast Trigger
	}

	CenteroftheStorm: {
		Tooltip:
			'''
			手持武器攻击时，每隔15秒释放一圈弹幕复制体
			复制体弹幕继承原弹幕的特性，但是伤害和速度将随机
			注：部分较为特殊的弹幕无法被复制
			“我是即将来临的风暴”
			'''
		DisplayName: 风暴中心
	}

	AmalgamationCodex: {
		Tooltip:
			'''
			你的任意攻击都可以造成一个随机的减益
