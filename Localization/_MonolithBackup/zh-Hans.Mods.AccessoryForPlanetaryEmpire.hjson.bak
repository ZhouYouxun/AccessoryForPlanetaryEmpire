				移动速度、跳跃速度、下落速度各增加30%，但是防御力减少20%
				按下快捷键将上述三个增益扩张到两倍
				“太快了，等等我”
				冷却时间60秒
				'''
		}

		SwiftWindWalkerBoots: {
			DisplayName: 疾风行者靴
			Tooltip:
				'''
				开启技能之后，在10秒内移动速度大幅提升且无敌
				冷却时间为45秒
				代价是无法造成伤害
				“你跑得越慢，跑得越快”
				'''
		}

		Teleportation: {
			DisplayName: 折跃启动引擎
			Tooltip:
				'''
