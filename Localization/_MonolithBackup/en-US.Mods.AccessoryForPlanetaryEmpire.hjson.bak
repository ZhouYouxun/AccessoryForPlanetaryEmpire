		NanoExcavator: {
			DisplayName: Nano Excavator
			Tooltip:
				'''
				Allows your non-summon projectiles to break blocks.
				!! Avoid using weapons with long durations !!
				!! Avoid using weapons with excessive range !!
				!! Avoid using overly intelligent weapons !!
				!! Do not use this at home !!
				I warned you. If you end up tearing down your house, don’t blame me.				   
				'''
		}

		SuperMoney: {
			DisplayName: Surprise Gift Box
			Tooltip:
				'''
				It seems you can’t open this gift,
				but perhaps someone is willing to buy it for a hefty price?				   
				'''
		}
	}

	StarPack: {
		DisplayName: B-1 Supply Pack
		Tooltip:
			'''
			It was originally meant to be carried on the back to provide extra backpack space. 
			Due to budgetary issues, it can only be opened once. 
			However, despite this, it still contains a lot of items.
			'''
	}

	Wings: {
		IMPWing: {
			DisplayName: Wings of Celestial Power
			Tooltip:
				'''
				-----[c/27ae60:Stars Moving Across the World]-----
				Health regeneration, damage, and defense each increased by 15.
				Allows for infinite flight.
				While airborne, pressing both up and down allows you to walk in the air as if on solid ground.
				Grants all effects of its materials.
				Double-tap left or right, or press the hotkey for a powerful dash.
				The dash grants invincibility, deals damage, and clears enemy projectiles.
				Press the Super Dash key to perform a long-distance, invincible dash with immense power and range.
				Multiplies your modifiers by 7 and applies them to the player.
				Grants the effects of the SpeedModActive, SwiftWindWalkerBoots, and Teleportation.
				"Speed knows no bounds, soaring across the skies, where the heart moves, a thousand miles can be reached."
				'''
		}
	}

	Y_TestAcc: {
		TheItem: {
			DisplayName: Crystal of Technology
			Tooltip:
				'''
				Essential for crafting all accessories in the mod.
				Each accessory requires one
				Can be purchased from the Mechanic
				Left-click to open the Lunar kit matrix catalog.
				"Indispensable, absolutely necessary."
				'''
		}
	}

	Dash: {
		ElfEnergyCore: {
			DisplayName: Elf Energy Core
			Tooltip:
