			敌人更有可能瞄准你
			'''
	}

	SpeedModActive: {
		DisplayName: "动力推进装置 "
		Tooltip:
			'''
			移动速度、跳跃速度、下落速度各增加30%，但是防御力减少20%
			按下快捷键将上述三个增益扩张到两倍
			“你就是速度的化身”
			冷却时间60秒
			'''
	}

	Teleportation: {
		DisplayName: "折跃启动引擎 "
		Tooltip:
			'''
			按下快捷键，到达鼠标所在的地方
			抵达时清除范围半径15格以内的所有敌方弹幕
			不会造成混沌减益，适合在深渊里使用
			冷却时间为15秒
			“好快，我就眨了一下眼！”
			'''
	}

	LiquidAbsorbentShield: {
		DisplayName: 世界综合体
		Tooltip:
			'''
			提供10%的攻击力，10%的攻击速度，5%的防御力，5点生命回复
			20%的移动速度，10%的伤害减免，10%的最大生命值，25%的最大魔力值
			“我什么都会一点”
			'''
	}

	SuperMoney: {
		DisplayName: "惊喜礼物盒 "
		Tooltip:
			'''
			你貌似打不开这个礼物
			但或许有人会愿意花亿点高价收购它？
			'''
	}

	WoDeShengGao: {
		DisplayName: 鼹鼠式仿生挖掘爪
		Tooltip:
			'''
			挖掘速度超大幅度提升
			注意：TML有挖掘上限，因此对于本来就挖掘速度很快的工具，它无法提供很大的提升
			“直接挖是吧？哎呀，哎呀呀，哎呀，我的审稿！”
			'''
	}

	SuperGlowstick: {
		DisplayName: 荧光棒之书
		Tooltip:
			'''
			左键释放荧光棒
			右键释放粘性荧光棒
			'''
	}

	SuperBomb: {
		DisplayName: 炸弹之书
		Tooltip:
			'''
			左键释放炸弹
			右键释放粘性炸弹
			'''
	}

	SpuperDynamite: {
		DisplayName: 雷管之书
		Tooltip:
			'''
			左键释放炸弹
			右键释放粘性炸弹
			'''
	}

	BeamSwordEX: {
		DisplayName: 镜面反射
		Tooltip: 在鼠标位置召唤八条剑气向旁边飞行
	}

	WehrmachtMachineGun: {
		DisplayName: 测试弓
		Tooltip: 随着使用时间的增加来提升攻击力和攻击速度
	}

	BulletBomb: {
		DisplayName: 子弹电磁脉冲-爆破
		Tooltip:
			'''
			引爆半径100格范围内的敌方子弹，消除他们的同时并造成高额伤害
			敌人的弹幕越多，这个技能造成的伤害就越大
			引爆的弹幕造成大范围内7倍的伤害，不会伤害到友军，同时有90秒的冷却
			“爆炸了！爆炸了！”
			'''
	}

	ShieldGeneratorOnDeployment: {
		DisplayName: 部署时护盾生成装置
		Tooltip:
			'''
			在刚复活的时候给予十秒的无敌
			“你复活辣”
			'''
	}

	StunEMP: {
		DisplayName: 子弹电磁脉冲-眩晕
		Tooltip:
			'''
			使用电磁脉冲将半径60格之内的敌方子弹暂停并大幅降低这个范围之内的敌人移动速度
			持续5秒，冷却时间35秒
			“让你的敌人有点头疼”
			'''
	}

	IMPWing: {
		DisplayName: 星界动力之翼
		Tooltip:
			'''
			星界能量在此翅膀中流动
			它给予了你无限翱翔的能力和[c/5272e9:难！ ][c/c8e553:以！ ][c/00c0e6:置！ ][c/8e1ad7:信！ ]的加速度
			'''
	}

	TheItem: {
		DisplayName: 科技结晶
		Tooltip:
			'''
			用于制作模组里的所有饰品
			“不可或缺，必不可少”
			'''
	}

	PlanetaryHook: {
		DisplayName: 星空锚钩
		Tooltip:
			'''
			你说你想要整个银河系？
			那为什么不把它钩过来？
			'''
	}

	EBall: {
		Tooltip:
			'''
			在鼠标位置发射8个电磁球
			测试用武器
			'''
		DisplayName: 星宇天爆
	}

	PainEditor: {
		DisplayName: 疼痛编辑器
		Tooltip:
			'''
			将单次最大伤害限制在你当前最大生命值的20%
			“你打不死我了，唉，你又打的死我了”
			'''
	}

	MechanicalHeart: {
		Tooltip:
			'''
			受到致命伤害是满血复活一次
			给予100的生命恢复和10秒的无敌
			两分半冷却，死亡后立刻重置冷却
			“唉，我刚刚死了，唉，我现在又活过来了，唉，气不气”
			'''
		DisplayName: 机械主义心脏
	}

	BloodPump: {
		Tooltip:
			'''
			替换掉治疗药水的效果，用一种更强大的治疗效果代替，冷却时间40秒
			按下绑定按键时立刻恢复已损失生命值的一半，并给予一个极强的生命回复和伤害减免
			与此同时给予40秒的治疗冷却
			“我受伤了，唉，我又回满血了”
			'''
		DisplayName: 活血泵
	}

	SubSpace: {
		Tooltip:
			'''
			按下快捷键时创建一个持续10秒的超时空立场
			立场内的玩家获得无敌，即便离开立场也能获得一秒钟的无敌
			对敌方弹幕和碰撞伤害都有效
			“你看得见我吗？你看得见吗？你看得见，但是你看不见！你看不见，但是你看得见！”
			'''
		DisplayName: 超时空场生成装置
	}

	NervousSystemDisorderDevice: {
		Tooltip:
			'''
			提升10%伤害
			按下快捷键时瘫痪半径100格圆形范围内的敌人
			但这是以瘫痪自己为代价的
			（降低敌方90%的移速和自身35%的移速，冷却时间45秒）
			“你的神经系统和敌人的神经系统都烧起来了！”
			'''
		DisplayName: 神经系统紊乱装置
	}

	EnergyShieldCatapult: {
		Tooltip:
			'''
			增加15%的伤害减免和跳跃速度
			增加15点防御力
			每隔5秒自动射出一发极其缓慢，但是能够自动消除敌人子弹的圆环状弹幕
			“狐假虎威! ”
			'''
		DisplayName: 能量盾弹射器
	}

	ControllableHalo: {
		Tooltip:
			'''
			增加25%的跳跃速度，15%的移速，和30%的飞行时间
			同时在鼠标处形成一个照明光环
			光环可以使你的敌人分崩离析，每秒造成最大生命值的2‰伤害
			“也许你可以试试只使用光环杀死BOSS？”
			'''
		DisplayName: 虚拟现实眼镜
	}

	SuperDice: {
		DisplayName: 超级幸运骰子
		Tooltip:
			'''
			增加7生命恢复，7防御力，7伤害减免
			但是武器的伤害和暴击率会开始随机波动
			伤害值从0.6~1.8倍随机波动
			暴击率从当前值~100随机波动
			“你以前就很幸运，所以我希望你能一直这么幸运下去”
			'''
	}

	AITrackingDevice: {
		DisplayName: 人工智能定位装置
		Tooltip:
			'''
			你所有的弹幕都能追杀敌人（召唤弹幕除外）
			注：部分特殊弹幕的武器可能会不起效果/起到反效果
			[i:4956][i:3541][i:2424][i:1513][i:2882][i:1947][i:757]
			当关闭饰品可见性时，可以让所有的弹幕都追踪敌人不做任何筛选
			“我不会告诉你他搭配无视无敌帧的弹幕输出会瞬间爆炸的”
			'''
	}

	AIATDevice: {
		DisplayName: 人工智能定位与穿透装置
		Tooltip:
			'''
			你的所有弹幕能够穿透方块并追杀敌人
			注：部分特殊弹幕的武器可能会不起效果/起到反效果
			[i:4956][i:3541][i:2424][i:1513][i:2882][i:1947][i:757]
			“曾经有人说过穿墙加追踪等于无敌，不知道这是不是真的”
			'''
	}

	HuskyAmulet: {
		DisplayName: 哈士奇护身符
		Tooltip:
			'''
			提升15%伤害，防御力加8
			按下快捷键进行左右方向的无敌冲刺
			“冲刺期间将摧毁家具（然而并不会）”
			[c/FF0000: --开发者物品--]
			'''
	}

	LuckyCoin: {
		DisplayName: 幸运金币
		Tooltip:
			'''
			当售出一个物品时，有60%概率额外返还一些金额
			返还金额在0到物品的售价之间随机浮动
			40%的概率则会亏损一些金额
			与此同时，你所携带的每一枚铂金币都能提升0.5%的伤害，上限为75%
			“因为你很穷，所以你很富，这是一个悖论”
			'''
	}

	LiquidAbsorbentShield2: {
		DisplayName: 世界综合体V2
		Tooltip:
			'''
			提供20%的攻击力，20%的攻击速度，10%的防御力，10点生命回复
			25%的移动速度，15%的伤害减免，15%的最大生命值，35%的最大魔力值
			“我什么都会一点^2”
			'''
	}

	Summon0: {
		DisplayName: 无限召唤器
		Tooltip:
			'''
			你拥有无限的召唤栏位和哨兵栏位 
			同时还顺便大幅提升了召唤武器攻速
			但相应的你的召唤伤害降为0
			“现在去向你的朋友炫耀你的私人军队吧”
			'''
	}

	HeartPacemaker: {
		Tooltip:
			'''
			增加15点生命回复
			生命值每损失10%，便会提供10点防御力和5%的伤害减免
			上限为损失90%生命，提供90点防御和45%的伤害减免
			“让你的内心更加坚固（物理）”
			'''
		DisplayName: 心脏起搏器
	}

	GamblersTopHat: {
		Tooltip:
			'''
			增加10%的攻击力
			武器有1%的概率造成50倍攻击的超暴击
			“哪有小孩天天哭，哪有赌徒一直输！”
			'''
		DisplayName: 赌徒礼帽
	}

	AedComponents: {
		Tooltip:
			'''
			每隔7秒生成一个红心在玩家周围，捡到恢复20生命值
			只有当血量低于90%时才会触发这个效果
			“吃啥补啥”
			'''
		DisplayName: Aed组件
	}

	BloodVesselAccelerator: {
		Tooltip:
			'''
			生命值低于50%时提升25生命再生速度，低于15%提升100，高于75%归零
			“血液新生！”
			'''
		DisplayName: 血管加速器
	}

	Z_CirculationSystemRetrofitKit: {
		Tooltip:
			'''
			同时拥有7个材料的所有效果：
			活血泵---------更强大的治疗药水效果
			机械主义心脏---受到致命伤害复活一次
			疼痛编辑器-----将单次伤害限制在最大生命值的20%
			心脏起搏器-----血量低时提供更高的防御力和伤害减免
			AED组件--------掉落爱心慢速回血
			血管加速器-----血量低时提供更高的生命回复
			生命复苏仪-----血量告急时创建快速回血的立场
			“你觉得你死得掉吗？现在”
			'''
		DisplayName: 循环系统改造套件
	}

	ShinyPlayingCards: {
		Tooltip:
			'''
			移除敌人的无敌帧，让穿透武器爆炸
			但是，代价是什么呢？
			代价是移除你自己的无敌帧
			“举个例子作为提示：[i:494]”
			'''
		DisplayName: 闪光扑克牌
	}

	CyberChip: {
		Tooltip:
			'''
			武器价值越高，就越能提供更高的伤害增幅
			每1金币提高1%的伤害，最大增幅为35%
			“贵就是好”
			'''
		DisplayName: 赛博筹码
	}

	GamblersGloves: {
		Tooltip:
			'''
			有20%的概率免疫一次攻击
			免疫失败会受到1.5倍伤害
			但是在接下来的5秒内提升攻击力和移动速度
			“更好用的闪避，我敢肯定”
			'''
		DisplayName: 赌徒手套
	}

	Z_GamblersKit: {
		Tooltip:
			'''
			同时拥有7个材料的所有效果：
			幸运骰子----武器的伤害与暴击率随机向上浮动
			幸运金币----出售物品时生产资金，背包里的资金提供额外输出来源
			赌徒礼帽----1%的概率造成50倍伤害
			赌徒手套----概率闪避攻击，闪避失败提升输出
			赛博筹码----根据武器价值最高提升35%的输出
			闪亮扑克----移除敌我双方的无敌帧
			赌徒领结----小概率制造三个复制体从天而降
			“你觉得你很幸运？”
			'''
		DisplayName: 赌徒套件
	}

	QuickDrawHolster: {
		Tooltip:
			'''
			远程武器在近距离时获得伤害增幅，最多为2.5倍
			“子弹速度随时间衰减，这很合理”
			'''
		DisplayName: 疾拔枪套
	}

	Scarab: {
		Tooltip:
			'''
			冷却时间60秒，持续时间10秒
			开启技能后自身无法移动，但近乎无敌
			反弹所有接触到的敌方射弹并造成三倍伤害
			对部分特殊的敌方射弹无效
			“以不变应万变”
			'''
		DisplayName: 圣甲虫外骨骼套装
	}

	SU_GiftofLcarus: {
		DisplayName: 伊卡鲁斯的礼物
		Tooltip:
			'''
			增加3仆从栏和3哨兵栏，30%的召唤伤害
			手持其他职业武器时有40%的概率让仆从、哨兵射出当前手持武器的弹幕
			注：部分特殊攻击动画的武器可能不起作用[i:2795][i:675]
			“给你的军队换上更好的武装！”
			'''
	}

	SU_HandheldBlackHole: {
		DisplayName: 可控引力发生器
		Tooltip:
			'''
			增加2哨兵栏
			让哨兵能够跟随玩家进行移动，而不是待在原地
			“移动堡垒！”
			'''
	}

	MA_BattlefieldMedicalSuitcase: {
		DisplayName: 战地医师手提箱
		Tooltip:
			'''
			降低35%的魔法伤害，魔法暴击归零，给予你无限的魔力，增加40%的魔法攻击速度
			最大生命值翻倍
			使用魔法武器攻击敌人时有概率治疗我方单位
			治疗量依据当前武器的面板而定
			“医者仁心”
			'''
	}

	MA_UnlimitedManaBackpack: {
		DisplayName: 无限奥术背包
		Tooltip:
			'''
			增加15%的魔法伤害与暴击，给予你无限的魔力
			按下绑定按键可以大幅提升魔法输出能力持续10秒
			但这是以失去视野和快速生命流失为代价的
			“到底是黑魔法还是现代科技？”
			'''
	}

	ME_DamageProtectionDevice: {
		DisplayName: 狂战士机械臂
		Tooltip:
			'''
			提升45%近战攻击力和30近战攻击速度，降低20%的伤害减免
			但是受伤时防御力与伤害减免归零，持续10秒
			“战士，但是活出了射手的样子”
			'''
	}

	ME_HandHeldMechanicalBuckler: {
		DisplayName: 手持机械圆盾
		Tooltip:
			'''
			加15防御力，加35%最大生命值，加15%减伤
			但是近战攻速-20，近战暴击-20%，近战攻击力-20%
			按下绑定按键可以大幅降低敌人的接触伤害，持续10秒
			“怕个锤子，上去跟他拼了”
			'''
	}

	RA_ArcaneQuiver: {
		DisplayName: 奥术箭袋
		Tooltip:
			'''
			提升25%的远程伤害和15的远程暴击率
			在玩家周围放置2组会公转的准星
			远程类弹幕穿过较近的两个准星时获得75%的伤害提升且必定暴击
			远程类弹幕穿过较远的两个准星时获得125%的伤害提升且必定暴击
			“虽然名字叫箭袋，但是所有远程武器都能享受加成”
			'''
	}

	RA_TriggerBulletBox: {
		DisplayName: 智能弹药箱
		Tooltip:
			'''
			增加10%的远程伤害和5%的远程暴击
			每隔5秒往鼠标位置自动打出一发灵液、咒火、纳米、爆破、黄金、水晶子弹
			辅助子弹的属性继承自当前手持武器（不手持远程武器也可以）
			在光标处生成粒子特效，可以关闭饰品可见性来取消这个功能
			“你再也不用手动切换弹药或武器了”
			'''
	}

	SwiftWindWalkerBoots: {
		DisplayName: 疾风行者靴
		Tooltip:
			'''
			开启技能之后，在10秒内移动速度大幅提升且无敌
			冷却时间为45秒
			代价是无法造成伤害
			“你跑得越慢，跑得越快”
			'''
	}

	FirepowerExoskeletonDevice: {
		Tooltip:
			'''
			受到伤害时提升200%攻击力，持续5秒
			只有当伤害大于等于最大生命值的15%才会生效
			“打不死我的，只会让我更加强大”
			'''
		DisplayName: 火力外骨骼套件
	}

	LawEnforcerGun: {
		Tooltip:
			'''
			左键全自动模式，快速射出大量子弹
			右键散射一片子弹
			[c/FF0000:传奇武器]：武器面板数据随游戏流程的推进而成长
			注：该武器未经平衡性测试，请谨慎使用
			'''
		DisplayName: 执法者突击步枪
	}

	Miao: {
		DisplayName: 妙妙枪
		Tooltip:
			'''
			射出随机弹幕!
			你不知道下一发弹幕是什么!
			“太妙了”
			注：该武器未经平衡性测试，请谨慎使用
			'''
	}

	VoidOfDarkness: {
		Tooltip:
			'''
			射出虚空精华，缓慢停下，随后锁定并追踪敌人
			虚空精华消失时释放数条虚空蠕虫撕咬敌人
			右键扔出长枪，在空中留下大量的虚空精华
			[c/FF0000:传奇武器]：武器面板数据随游戏流程的推进而成长
			注：该武器未经平衡性测试，请谨慎使用
			'''
		DisplayName: 暗之虚无
	}

	InfDarkness: {
		DisplayName: 城市毁灭者
		Tooltip:
			'''
			旋转长枪造成近距离范围内的真近战伤害
			注：该武器未经平衡性测试，请谨慎使用
			'''
	}

	ThermalShotgun: {
		DisplayName: 热能之熵
		Tooltip:
			'''
			左键散射子弹，转化火枪子弹为高温子弹
			右键射出3颗高温烟雾弹
			[c/FF0000:传奇武器]：武器面板数据随游戏流程的推进而成长
			注：该武器未经平衡性测试，请谨慎使用
			'''
	}

	ClockworkStar: {
		DisplayName: 发条之星
		Tooltip:
			'''
			轻型狙击步枪，一下射出四发子弹
			击中敌人后召唤更多子弹，具备追踪能力并治疗我方单位
			无限穿墙并穿透，遇到物块并反弹
			[c/FF0000:传奇武器]：武器面板数据随游戏流程的推进而成长
			注：该武器未经平衡性测试，请谨慎使用
			'''
	}

	BrassBow: {
		DisplayName: 铜铸星弓
		Tooltip:
			'''
			左键蓄力散射弓箭，随时间增加射速并减少散射范围
			转化木箭为黄铜箭，击中敌人后召唤额外的激光
			蓄力到最高层级时，每隔一段时间能散射激光并扔出几颗空中滞留的地雷
			右键射出一支巨大的箭矢，拥有2倍的飞行速度和15倍的伤害，不转化弹幕
			[c/FF0000:传奇武器]：武器面板数据随游戏流程的推进而成长
			注：该武器未经平衡性测试，请谨慎使用
			'''
	}

	GamblersBowTie: {
		DisplayName: 赌徒领结
		Tooltip:
			'''
			在使用非召唤武器时有25%的概率额外射出三发弹幕复制品
			复制品会从天而降，伤害波动为0.5倍到1.9倍
			“我还是我自己吗”
			'''
	}

	LifeSubSpace: {
		DisplayName: 生命复苏仪
		Tooltip:
			'''
			当玩家血量不足20%时，自动在原地创建一个治疗光环
			进入光环内的所有玩家都会被清除负面效果并给予快速回血
			这个效果有90秒的冷却时间
			如果升级为循环系统改造套件，那么冷却时间将缩短至45秒
			“为人民服务”
			'''
	}

	AsteroidBelt: {
		DisplayName: 小行星杯
		Tooltip:
			'''
			制造一个小行星，围绕你旋转
			它会为你挡下敌人的弹幕
			但是挡下我发弹幕就会破裂一段时间
			“质量好像不是特别好”
			'''
	}

	OpticalLensMatrix: {
		DisplayName: 光学镜矩阵
		Tooltip:
			'''
			让非召唤弹幕分裂成6发，每发有25%的原伤害
			“多就是好”
			'''
	}

	DoomsdayTechExperiment: {
		DisplayName: 末日科技实验体
		Tooltip:
			'''
			当玩家不发动攻击的时候，每1.5秒增加手持非召唤武器一倍的攻击力
			上限为15秒增加10倍
			“高就是好”
			'''
	}

	MomentumChip: {
		DisplayName: 动能芯片
		Tooltip:
			'''
			根据玩家当前的移速提升伤害
			最高30%提升
			“唯快不破”
			'''
	}

	ShallowOxygenBottle: {
		Tooltip:
			'''
			进行强而有力的水能冲刺，免疫敌人碰撞伤害
			关闭饰品可见性让它使用左右双击键冲刺
			开启饰品可见性让它使用单键冲刺
			“这是公爵的标配”
			'''
		DisplayName: 浅滩氧气瓶
	}

	ElfEnergyCore: {
		DisplayName: 精灵能量核心
		Tooltip:
			'''
			进行强而有力的能量冲刺，免疫敌人弹幕伤害
			关闭饰品可见性让它使用左右双击键冲刺
			开启饰品可见性让它使用单键冲刺
			“这是精灵女王的标配”
			'''
	}

	PowerJetPack: {
		DisplayName: 电能喷气背包
		Tooltip:
			'''
			进行极长极远极快的电能冲刺
			冲刺期间免疫一切伤害，并对敌人造成高额碰撞伤害
			冲刺冷却时间为20秒
			“火星科技，压缩冲刺”
			'''
	}

	AncientGift: {
		DisplayName: 远古之礼
		Tooltip:
			'''
			四种职业的武器都会射出不同的辅助弹幕
			日耀弹幕会逐渐减速并滞留在原地
			星旋弹幕碰到物块后平行滑行并穿透敌人
			星云弹幕围绕玩家做圆弧运动
			星尘弹幕吸附在别人身上造成极高的持续伤害
			“四神柱的力量被封印在这里面”
			'''
	}

	FlowerVine: {
		DisplayName: 万花之藤
		Tooltip:
			'''
			近战武器挥砍可以反弹敌人弹幕，反弹成功后进入3秒冷却
			“所以你说那朵花里面藏了一把加特林，是真的吗？”
			'''
	}

	StellarCleaver: {
		DisplayName: 恒星切割者
		Tooltip:
			'''
			初始之时，威力虽凡；无止之噬，脑中魔冕；
			亡灵之首，狱火重生；炼金造物，力量激荡；
			视域守卫，光辉耀眼；鳞甲震荡，地震之力；
			无限可怖，虽三者之首，但也败于麾下；
			远古丛生之地，太阳巨灵之心；
			月之暗面巨兽，光辉重现之日；
			成长随旅途，镐刃永延；击败众强敌，威力飞升；
			右键当做锤斧使用
			“人话：镐力和攻击力随游戏进度而成长”
			'''
	}

	MercuryAccessory: {
		DisplayName: 水星
		Tooltip:
			'''
			召唤围绕玩家的水星
			水星将为玩家提供周期性的高额伤害减免
			被击中时伤害减免和防御力归零持续10秒
			如果升级至太阳系，那么被击中时将不会有惩罚
			“迅捷星飞驰，护主四方隐”
			'''
	}

	EarthAccessory: {
		DisplayName: 地球
		Tooltip:
			'''
			召唤围绕玩家的地球
			地球将每隔10秒让玩家恢复100生命值
			如果升级至太阳系，那么治疗冷却缩短至5秒
			“无尽恩泽洒，疗愈众生心”
			'''
	}

	MarsAccessory: {
		DisplayName: 火星
		Tooltip:
			'''
			召唤围绕玩家的火星
			火星将向敌人喷吐追踪分裂火焰，火焰伤害为手持武器的0.75倍
			如果升级至太阳系，那么伤害倍率提升至1.5倍，攻击间隔从三秒缩短至二秒
			“炎弹狂舞动，敌阵皆溃散”
			'''
	}

	JupiterAccessory: {
		DisplayName: 木星
		Tooltip:
			'''
			召唤围绕玩家的木星
			木星将对敌人造成1500的碰撞伤害
			如果升级至太阳系，那么伤害提升至3000
			“碰撞如雷霆，爆破声震天”
			'''
	}

	SaturnAccessory: {
		DisplayName: 土星
		Tooltip:
			'''
			召唤围绕玩家的土星
			土星将散射在屏幕边缘反弹的星环
			星环基础伤害为450点，每次反弹都会增加伤害
			如果升级至太阳系，那么伤害提升至650
			“星环回旋击，敌影尽消亡”
			'''
	}

	UranusAccessory: {
		DisplayName: 天王星
		Tooltip:
			'''
			召唤围绕玩家的天王星
			天王星将干扰附近的敌人降低移速，并有概率冻结敌人
			如果升级至太阳系，那么干扰半径提升40%
			“寒气四散漫，敌动难自由”
			'''
	}

	PlutoAccessory: {
		DisplayName: 冥王星
		Tooltip:
			'''
			召唤围绕玩家的冥王星
			冥王星将挡下一切触碰到他的弹幕，并有概率让他们弹回
			“冰冷暗影藏，破敌技无痕”
			'''
	}

	HalleyCometAccessory: {
		DisplayName: 哈雷彗星
		Tooltip:
			'''
			召唤以椭圆形轨道围绕玩家的哈雷彗星
			哈雷彗星能够增强接触到其的玩家弹幕75%伤害和30%速度
			“彗光划长空，助主破敌方”
			'''
	}

	NeptuneAccessory: {
		DisplayName: 海王星
		Tooltip:
			'''
			召唤围绕玩家的海王星
			海王星能够和玩家同步发动进攻
			射出海王星三叉戟，在鼠标处切割敌人，倍率为手持武器的0.5倍
			如果升级至太阳系，那么伤害倍率提升至1.0倍
			“水弹急如梭，冰封阻敌前”
			'''
	}

	VenusAccessory: {
		DisplayName: 金星
		Tooltip:
			'''
			召唤围绕玩家的金星
			金星将周期性的释放冲击波，粉碎敌人的防御和减伤
			“烈焰环绕我，敌防尽消融”
			'''
	}

	SunAccessory: {
		DisplayName: 太阳
		Tooltip:
			'''
			召唤停在玩家头顶的太阳
			太阳能够向四周射出日耀射线，并在鼠标位置天降大型恒星之罚
			“光芒照万丈，灼热燃耀天”
			'''
	}

	TheSolarSystem: {
		DisplayName: 太阳系
		Tooltip:
			'''
			全职业伤害+25%，全职业暴击+15%，移速+15%，最大生命值+25%
			近战攻速+25%，远程弹速+30%，魔力消耗-40%，召唤与哨兵栏+4
			召唤整个太阳系为你作战
			迅捷星飞驰，护主四方隐，那是水星
			烈焰环绕我，敌防尽消融，那是金星
			无尽恩泽洒，疗愈众生心，那是地球
			炎弹狂舞动，敌阵皆溃散，那是火星
			碰撞如雷霆，爆破声震天，那是木星
			星环回旋击，敌影尽消亡，那是土星
			寒气四散漫，敌动难自由，那是天王星
			水弹急如梭，冰封阻敌前，那是海王星
			冰冷暗影藏，破敌技无痕，那是冥王星
			彗光划长空，助主破敌方，那是哈雷彗星
			光芒照万丈，灼热燃耀天，那是太阳
			星际环绕我，众星护主身，那便是全太阳系
			“感谢您游玩本模组和对本模组的支持，如果可以，请期待我的下一个作品！”
			'''
	}

	DarkSideOfTheMoon: {
		Tooltip:
			'''
			每受到3次伤害，便会往周围弹出一大堆能阻挡弹幕的月亮护盾
			护盾持续10秒，阻挡次数无限
			“这是月球领主的法术，它觉得可能会太欺负你于是没有在战斗中使用出来”
			'''
		DisplayName: 月之暗面
	}

	SlimeShield: {
		DisplayName: 粘液盾牌
		Tooltip:
			'''
			每受到5次伤害，便会往周围弹出一大堆能阻挡弹幕的粘液护盾
			护盾持续10秒，阻挡1次数后便会销毁
			“据说史莱姆王就是用这种盾牌让他在族群中的战斗中势不可挡的”
			'''
	}

	SteelAndFleshHeart: {
		DisplayName: 血肉与钢铁之心
		Tooltip:
			'''
			禁用治疗药水和生命再生
			但是将单次伤害限制在最大生命值的5%
			“这是来自血肉墙的无限增殖能力”
			'''
	}

	ShinySlimeShield: {
		Tooltip:
			'''
			每隔五秒往鼠标位置扔出两个闪光粘液盾牌
			护盾持续10秒，阻挡2次数后便会销毁
			“粉粉嫩嫩的，多可爱”
			'''
		DisplayName: 亮晶晶的粘液盾牌
	}

	DeathNote: {
		Tooltip:
			'''
			向周围的敌人施加地牢恶咒，每隔5秒造成当前生命值的5%的伤害
			但你自己也会额外受到50%的伤害
			（某些免疫所有减益的敌怪不受此影响）
			“坏到骨子里了”
			'''
		DisplayName: 死亡笔记
	}

	SweetheartCloak: {
		Tooltip:
			'''
			进行强而有力的蜂蜜冲刺，有25%的概率免疫伤害
			关闭饰品可见性让它使用左右双击键冲刺
			开启饰品可见性让它使用单键冲刺
			“不许奴役蜜蜂”
			'''
		DisplayName: 甜蜜披风
	}

	BrainInJar: {
		Tooltip:
			'''
			攻击时射出小型吞噬者协同作战，倍率为手持武器的35%
			受到伤害时释放飞眼怪攻击敌人，倍率为手持武器的50%
			“不提供闪避和减伤”
			'''
		DisplayName: 罐中大脑
	}

	Absorber15: {
		DisplayName: 15型能量吸收装置
		Tooltip:
			'''
			按下电磁脉冲键时，清除半径15格内的敌方弹幕
			将每一发被清理的弹幕转化为3.5%的临时伤害提升，持续5秒
			冷却时间为45秒
			“没有枪没有炮，敌人给我们造”
			'''
	}

	Interceptor15: {
		DisplayName: 15型弹幕拦截器
		Tooltip:
			'''
			按下电磁脉冲键时，清除半径15格内的敌方弹幕
			冷却时间为45秒
			“消！除！光！线！”
			'''
	}

	Interceptor25II: {
		DisplayName: 25II型弹幕拦截器
		Tooltip:
			'''
			按下电磁脉冲键时，清除半径25格内的敌方弹幕
			同时对范围内的敌人施加一次困惑debuff
			冷却时间为45秒
			“你困惑了吗？是的！”
			'''
	}

	Interceptor35IV: {
		DisplayName: 35IV型弹幕拦截器
		Tooltip:
			'''
			按下电磁脉冲键时，清除半径35格内的敌方弹幕
			同时将周围散射大量激光
			冷却时间为45秒
			“毁灭者的精华”
			'''
	}

	Interceptor45: {
		DisplayName: 45型转化弹幕拦截器
		Tooltip:
			'''
			按下电磁脉冲键时，清除半径55格内的敌方弹幕
			50%将敌方弹幕反转成有方弹幕并原路返回
			冷却时间为45秒
			“离间计并不总是起效，不是吗？”
			'''
	}

	Interceptor55IX: {
		DisplayName: 55IX型转化弹幕拦截器
		Tooltip:
			'''
			按下电磁脉冲键时，清除半径55格内的敌方弹幕
			100%将敌方弹幕反转成有方弹幕并原路返回
			冷却时间为45秒
			“从物质上的反转总是能起效”
			'''
	}

	Interceptor55I: {
		DisplayName: 55I型连锁引爆炮
		Tooltip:
			'''
			按下电磁脉冲键时，清除半径55格内的敌方弹幕
			弹幕被清除时会被引爆，对小范围内的敌人造成5倍原弹幕伤害
			冷却时间为45秒
			“强大的堡垒往往从内部破裂”
			'''
	}

	Interceptor55VI: {
		DisplayName: 55VI型震荡弹射器
		Tooltip:
			'''
			按下电磁脉冲键时，清除半径55格内的敌方弹幕
			同时将范围内的敌人眩晕3秒
			冷却时间为45秒
			“他们重新站起来的速度简直惊人，不是吗？”
			'''
	}

	Barrier25d: {
		DisplayName: 25d型屏障生成装置
		Tooltip:
			'''
			按下电磁脉冲键时，在原地放置一个半径25格的屏障
			屏障能在存在的10秒钟内阻挡敌人子弹
			冷却时间为30秒
			“仅仅是改变分子之间的移动速度罢了”
			'''
	}

	SubSpace25e: {
		DisplayName: 25f型超时空场生成装置
		Tooltip:
			'''
			按下电磁脉冲键时，在原地放置一个半径25格的超时空力场
			力场能够在10秒的存在时间内为内部的所有玩家提供无敌
			冷却时间为30秒
			“通过空间压缩与折叠技术产生的超时空力场”
			'''
	}

	Interceptor65L: {
		DisplayName: 65L型激光弹幕拦截器
		Tooltip:
			'''
			每次按下电磁脉冲键时，清除距离玩家最近的一发敌方弹幕
