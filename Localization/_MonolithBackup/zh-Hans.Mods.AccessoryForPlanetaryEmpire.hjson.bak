Accessory: {
	Attack: {
		SolarSystem: {
			MercuryAccessory: {
				DisplayName: 水星
				Tooltip:
					'''
					召唤围绕玩家的水星
					水星将为玩家提供周期性的高额伤害减免
					被敌人或弹幕击中时伤害减免和防御力归零持续10秒
					[c/BFC5CC:其他受伤方式不会导致减伤终止和惩罚]
					如果升级至太阳系，那么被击中时将不会有惩罚
					“它跟水和水银没有任何关系”
					'''
			}

			EarthAccessory: {
				DisplayName: 地球
				Tooltip:
					'''
					召唤围绕玩家的地球
					地球将每隔10秒让玩家恢复100生命值
					如果升级至太阳系，那么治疗冷却缩短至5秒
					如果在一个“好世界”里，那么治疗量会乘以2.5倍
					“尖端医疗科技”
					'''
			}

			MarsAccessory: {
				DisplayName: 火星
				Tooltip:
					'''
					召唤围绕玩家的火星
					火星将向敌人喷吐追踪分裂火焰，火焰伤害为手持武器的0.75倍
					如果升级至太阳系，那么伤害倍率提升至1.5倍，攻击间隔从三秒缩短至二秒
					“他拥有着最高的山峰”
					'''
			}

			JupiterAccessory: {
				DisplayName: 木星
				Tooltip:
					'''
					召唤围绕玩家的木星
					木星将对敌人造成1500的碰撞伤害
					如果升级至太阳系，那么伤害提升4500
					“引力巨大”
					'''
			}

			SaturnAccessory: {
				DisplayName: 土星
				Tooltip:
					'''
					召唤围绕玩家的土星
					土星将散射在屏幕边缘反弹的星环
					星环基础伤害为450点，每次反弹都会增加伤害
					如果升级至太阳系，那么伤害提升至650
					“不，他一点也不土”
					'''
			}

			UranusAccessory: {
				DisplayName: 天王星
				Tooltip:
					'''
					召唤围绕玩家的天王星
					天王星将干扰附近的敌人降低移速，并有概率冻结敌人
					如果升级至太阳系，那么干扰半径提升40%
					“铀元素的名字就来源于这颗行星”
					'''
			}

			PlutoAccessory: {
				DisplayName: 冥王星
				Tooltip:
					'''
					召唤围绕玩家的冥王星
					冥王星将挡下一切触碰到他的弹幕，并有概率让他们弹回
					“不要问我卡戎去哪了”
					'''
			}

			HalleyCometAccessory: {
				DisplayName: 哈雷彗星
				Tooltip:
					'''
					召唤以椭圆形轨道围绕玩家的哈雷彗星
					哈雷彗星能够增强接触到其的玩家弹幕75%伤害和30%速度
					“划过夜空的漂亮轨迹”
					'''
			}

			NeptuneAccessory: {
				DisplayName: 海王星
				Tooltip:
					'''
					召唤围绕玩家的海王星
					海王星能够召唤四根围绕自己旋转的三叉戟发动远程攻击
					“波塞冬专属”
					'''
			}

			VenusAccessory: {
				DisplayName: 金星
				Tooltip:
					'''
					召唤围绕玩家的金星
					金星将周期性的释放冲击波，粉碎敌人的防御和减伤
					“谁能想到他居然才是最热的”
					'''
			}

			SunAccessory: {
				DisplayName: 太阳
				Tooltip:
					'''
					召唤停在玩家头顶的太阳
					每隔一段时间射出大量太阳耀斑
					曲线飞行造成成吨伤害
					最后返回玩家为玩家回血
					“将军！”
					'''
			}

			TheSolarSystem: {
				DisplayName: 太阳系
				Tooltip:
					'''
					-----[c/f1c40f:星辰加冕]-----
					全职业伤害+25%，全职业暴击+15%，移速+15%，最大生命值+25%
					近战攻速+25%，远程弹速+30%，魔力消耗-40%，召唤与哨兵栏+4
					召唤4个引力场和整个太阳系为你作战
					迅捷星飞驰，护主四方隐，那是水星
					烈焰环绕我，敌防尽消融，那是金星
					无尽恩泽洒，疗愈众生心，那是地球
					炎弹狂舞动，敌阵皆溃散，那是火星
					碰撞如雷霆，爆破声震天，那是木星
					星环回旋击，敌影尽消亡，那是土星
					寒气四散漫，敌动难自由，那是天王星
					水弹急如梭，冰封阻敌前，那是海王星
					冰冷暗影藏，破敌技无痕，那是冥王星
					光芒照万丈，灼热燃耀天，那是太阳
					星际环绕我，众星护主身，那便是全太阳系
					“星河灿烂，宇宙无垠，唯有光辉者方能驾驭苍穹”
					'''
			}

			GravitationalField: {
				DisplayName: 四联装引力场
				Tooltip:
					'''
					以玩家为中心召唤两对引力准星
					玩家的非召唤弹幕穿过引力准心能够获得速度和伤害增幅
					穿过较近的两个准星时获得75%的伤害提升且必定暴击
					穿过较远的两个准星时获得125%的伤害提升且必定暴击
					“扭曲时空”
					'''
			}
		}

		Gambler: {
			CyberChip: {
				DisplayName: 赛博筹码
				Tooltip:
					'''
					武器价值越高，就越能提供更高的伤害增幅
					每1金币提高1%的伤害，最大增幅为35%
					“贵就是好”
					'''
			}

			GamblersBowTie: {
				DisplayName: 赌徒领结
				Tooltip:
					'''
					在使用非召唤武器时有25%的概率额外射出三发弹幕复制品
					复制品会从天而降，伤害波动为0.5倍到1.9倍
					“我还是我自己吗”
					'''
			}

			GamblersGloves: {
				DisplayName: 赌徒手套
				Tooltip:
					'''
					有20%的概率免疫一次攻击
					免疫失败会受到1.5倍伤害
					但是在接下来的5秒内提升攻击力和移动速度
					“更好用的闪避，我敢肯定”
					'''
			}

			GamblersTopHat: {
				DisplayName: 赌徒礼帽
				Tooltip:
					'''
					增加10%的攻击力
					武器有1%的概率造成50倍攻击的超暴击
					“哪有小孩天天哭，哪有赌徒一直输！”
					'''
			}

			LuckyCoin: {
				DisplayName: 幸运金币
				Tooltip:
					'''
					当售出一个物品时，有60%概率额外返还一些金额
					返还金额在0到物品的售价之间随机浮动
					40%的概率则会亏损一些金额
					与此同时，你所携带的每一枚铂金币都能提升0.5%的伤害，上限为75%
					铂金币必须放在人物背包里才会生效，放置在存钱罐、大背包中无效
					“因为你很穷，所以你很富，这是一个悖论”
					'''
			}

			ShinyPlayingCards: {
				DisplayName: 闪光扑克牌
				Tooltip:
					'''
					移除敌人的无敌帧，让穿透武器爆炸
					但是，代价是什么呢？
					代价是移除你自己的无敌帧
					如果在一个“好世界”里，那么不会移除玩家的无敌帧
					“不是你死就是我亡”
					'''
			}

			SuperDice: {
				DisplayName: 超级幸运骰子
				Tooltip:
					'''
					增加7生命恢复，7防御力，7伤害减免
					但是武器的伤害和暴击率会开始随机波动
					伤害值从0.6~1.8倍随机波动
					暴击率从当前值~100随机波动
					如果在一个“好世界”里，那么伤害的浮动范围变成1.2倍到2.5倍
					“你以前就很幸运，所以我希望你能一直这么幸运下去”
					'''
			}

			Z_GamblersKit: {
				DisplayName: 赌徒套件
				Tooltip:
					'''
					-----[c/f39c12:孤注一掷]-----
					拥有其材料的所有效果
					根据武器价值最高提升35%的输出（赛博筹码）
					武器的伤害与暴击率随机向上浮动（幸运骰子）
					出售物品时生产资金，背包里的资金提供额外输出来源（幸运金币）
					小概率制造三个复制体从天而降（赌徒领结）
					概率闪避攻击，闪避失败提升输出（赌徒手套）
					0.5%的概率造成50倍伤害（赌徒礼帽）
					通过饰品可见性来移除敌我双方的无敌帧（闪亮扑克）
					“命运的骰子已经掷出，胜负只在一瞬之间”
					'''
			}
		}

		JobSkill: {
			TriggerBulletBox: {
				DisplayName: 智能弹药箱
				Tooltip:
					'''
					增加10%的远程伤害和5%的远程暴击
					每隔5秒往鼠标位置自动打出一发灵液、咒火、纳米、爆破、黄金、水晶子弹
					辅助子弹的属性继承自当前手持武器（不手持远程武器也可以）
					在光标处生成粒子特效，可以关闭饰品可见性来取消这个功能
					“你再也不用手动切换弹药或武器了”
					'''
			}
		}

		ModProj: {
			AITrackingDevice: {
				DisplayName: 人工智能定位装置
				Tooltip:
					'''
					你所有的弹幕都能追杀敌人（召唤弹幕除外）
					注：部分特殊弹幕的武器可能会不起效果/起到反效果
					[i:4956][i:3541][i:2424][i:1513][i:2882][i:1947][i:757]
					“超级瞄准已部署”
					'''
			}

			BulletScreenManagementTerminal: {
				DisplayName: 终级弹幕管理终端
				Tooltip:
					'''
					-----[c/9b59b6:弹影流星]-----
					弹幕可以必定暴击，降低魔力消耗至0，伤害加30%
					拥有其材料的所有效果
					近距离造成额外伤害（快速扳机）
					按移动速度比例增加手持武器伤害（动能芯片）
					敌人防御力越高，就会增加更高的攻击力（破阵冲击钻）
					按游戏流程提升固定数值的攻击力（先进战斗硬盘）
					开关饰品可见性来让非穿透弹幕在引爆时造成更高伤害（相位投影仪）
					按下快捷键在6种弹幕模式中循环切换：
					0 关闭：什么都不做
					1 故障：随机触发20多种小故障中的其中一种
					2 引力：围绕玩家自己公转
					3 加速：弹幕速度与伤害随时间指数加速
					4 定位：追杀距离弹幕最近的敌人
					5 回声：弹幕在屏幕边缘反弹并增加伤害
					6 云浮：弹幕随鼠标一起移动
					可以兼容盗贼
					“子弹如星，瞬间闪烁，弹道中藏着无尽的杀机”
					'''
			}

			EchoBoundary: {
				DisplayName: 回声边界
				Tooltip:
					'''
					让你的非召唤弹幕能够在屏幕边缘反弹
					每反弹一次增加5%的伤害
					反弹上限为5次
					“和你的弹幕来一场说走就走的旅行”
					'''
			}

			GlitchCore: {
				DisplayName: 故障核心
				Tooltip:
					'''
					让你的非召唤弹幕随机触发各种“小故障”
					小故障有好有坏，抽到什么纯靠运气
					“我才不会告诉你这些是正收益还是负收益”
					'''
			}

			NebulaBracelet: {
				DisplayName: 云浮钓竿
				Tooltip:
					'''
					你射出的弹幕将会跟随你的鼠标移动
					如果接近鼠标，则会围绕鼠标做圆周运动
					“你不知道该打谁”
					'''
			}

			ParticleAccelerator: {
				DisplayName: 精金粒子加速器
				Tooltip:
					'''
					降低非召唤弹幕的初始速度为初始的20%，但让其随时间指数提升
					最大可以提升至弹幕原速度的300%
					弹幕伤害也会由低提升至高，倍率与速度相同
					“1974年，第一次用铬-54离子轰击锇-248”
					'''
			}

			PhaseProjector: {
				DisplayName: 相位投影仪
				Tooltip:
					'''
					非穿透弹幕在碰到敌人时不会消失，而是继续飞行
					在主动消失的时候造成两倍伤害
					“出其不意，攻其不备！”
					'''
			}

			Universalgravitation: {
				DisplayName: 万象天引
				Tooltip:
					'''
					你射出的非召唤弹幕将围绕你做圆周运动直至消失
					弹幕飞行速度会逐渐增大
					弹幕的公转轨道会试图定位到敌人所在的轨道
					换句话说，公转半径会逐渐趋近于与敌人的距离
					“世界中心”
					'''
			}

			PermanentModProj: {
				UltraHighCrit: {
					DisplayName: 超高暴击指环
					Tooltip:
						'''
						玩家的每次攻击都必定暴击(暴击率加100%)，但是防御力减少25%
						“召唤师流下了眼泪”
						'''
				}

				MomentumChip: {
					DisplayName: 动能芯片
					Tooltip:
						'''
						根据移动速度百分比提升伤害
						当移动速度达到最高时能够提升最高30%伤害
						“速度，速度，我就是速度”
						'''
				}

				QuickDrawHolster: {
					DisplayName: 快速扳机
					Tooltip:
						'''
						远程武器在近距离射击时能够获得最高1.4倍的伤害提升
						“子弹速度随时间衰减，因此这很合理”
						'''
				}

				AttackIndicator: {
					DisplayName: 先进战斗芯片
					Tooltip:
						'''
						固定提升伤害（3肉前，7肉后，16花后，30月后）
						此伤害提升独立于任何其他来源的伤害提升和无敌帧
						“老旧的书本能承载的知识已经太少了，因此这次换成了固态硬盘”
						'''
				}

				BreakingDrill: {
					DisplayName: 破阵冲击钻
					Tooltip:
						'''
						敌人的每1点防御力都能为你提供2%的额外伤害
						“我的钻头可是突破天际的！”
						'''
				}
			}
		}

		SummonOnly: {
			ArmyBattleBanner: {
				DisplayName: 军团战旗
				Tooltip:
					'''
					将你的仆从栏位强制变为1
					每损失的一个仆从栏额外提供90%的召唤伤害增幅
					每损失的一个哨兵栏额外提供200%的召唤伤害增幅
					“不再是军队 现在是保镖了”
					'''
			}

			CelestialDominion: {
				DisplayName: 天穹领域
				Tooltip:
					'''
					-----[c/e74c3c:召唤星域]-----
					召唤栏与哨兵栏+10，召唤伤害加80%
					拥有其材料的所有效果
					手持其他职业的武器的时候也能提升召唤能力（协同催化剂）
					与此同时，召唤物有概率射出这种其他职业的弹幕（伊卡鲁斯之礼）
					每持有一个召唤物便会提升最大生命值和生命回复，召唤物能够吸血（医疗无人机）
					召唤物在距离玩家近的时候能够阻挡弹幕，而在距离远的时候能够增强我方弹幕（充能几丁质）
					召唤物击中敌人时给予玩家可堆叠的鞭子增益（驯兽鞭环）
					开启装备可见性将召唤栏与哨兵栏设为1并给予对应的伤害增幅，反之亦然（军团战旗）
					哨兵会跟随玩家移动，而不是站在原地（可控黑洞）
					“星辰听从召唤，苍穹为你而开，万物皆在你掌控之中”
					'''
			}

			EnergizedChitin: {
				DisplayName: 充能几丁质
				Tooltip:
					'''
					当仆从距离玩家小于25格时有25%概率消除敌方弹幕
					距离玩家超过50格时有50%概率增强我方非召唤弹幕50%伤害
					仆从会释放对应颜色的粒子特效来表示功能
					“你说没闻过几丁质着火的味道？你没有用电蚊拍电过蚊子吗”
					'''
			}

			GiftofLcarus: {
				DisplayName: 伊卡鲁斯的礼物
				Tooltip:
					'''
					增加3仆从栏和1哨兵栏，30%的召唤伤害
					手持其他职业武器时有40%的概率让仆从、哨兵射出当前手持武器的弹幕
					额外弹幕有60帧的冷却时间
					注：部分特殊攻击动画的武器可能不起作用[i:2795][i:675]
					“给你的军队换上更好的武装！”
					'''
			}

			HandheldBlackHole: {
				DisplayName: 可控黑洞
				Tooltip:
					'''
					增加2哨兵栏
					让哨兵能够跟随玩家进行移动，而不是待在原地
					“移动堡垒！”
					'''
			}

			MedicalDrones: {
				DisplayName: 医疗无人机
				Tooltip:
					'''
					降低45%召唤伤害
					但是每存在一个仆从便会提供25的最大生命值，和5生命回复
					上限为20个仆从提升500最大生命值和100生命恢复
					击中敌人时有30%概率吸血，吸血量取决于仆从造成的伤害的5%~30%
					“冥士追魂”
					'''
			}

			SynergisticCatalyst: {
				DisplayName: 协同催化剂
				Tooltip:
					'''
					手持非召唤武器攻击敌人时
					有10%的概率随机提升召唤物面板伤害，持续10秒
					随机增幅从5%到30%
					“知己知彼，方能百战不怡”
					'''
			}

			TamingWhipRing: {
				DisplayName: 驯兽鞭环
				Tooltip:
					'''
					仆从数量-3，伤害-30%
					但是仆从击中敌人时，能够给予玩家鞭子15%攻速和鞭子50%攻击力加成的buff
					Buff最多可以叠加7次，最高350%鞭子伤害和105%鞭子攻速
					“You Gotta Move~ You Gotta Move~”
					'''
			}
		}

		AmalgamationCodex: {
			DisplayName: 混合元素法典
			Tooltip:
				'''
				你的任意攻击都可以造成一个随机的减益
				与此同时，你还能免疫大多数来自敌人的减益
				是的，它能兼容其他模组
				你开的模组越多，它越厉害
				“现代元素使”
				'''
		}

		AntimatterNuclearMissile: {
			DisplayName: 洲际导弹发射井
			Tooltip:
				'''
				当boss存活时开始装填，装填一枚核导弹需要10分钟的时间
				在这期间，敌人或自己死亡会重新开始装填
				装填完成后立刻发射，杀死所有Boss
				核导弹无视任何防御力、伤害减免、防秒杀机制
				该过程无法被任何手段加速
				如果在一个“好世界”里，那么装填时间缩短至5分钟
				“核威慑”
				'''
		}

		ArtisansToken: {
			DisplayName: 工匠令牌
			Tooltip:
				'''
				本身不提供加成
				而是将自身的修饰语乘以7倍
				仅支持原版泰拉瑞亚的修饰语
				“那名奸商还挺讲道理的”
				'''
		}

		ControllableHalo: {
			DisplayName: 虚拟现实眼镜
			Tooltip:
				'''
				增加25%的跳跃速度，15%的移速，和30%的飞行时间
				同时在鼠标处形成一个照明光环
				光环可以使你的敌人分崩离析，每秒造成最大生命值的2‰伤害
				“这个光环有照明功能”
				'''
		}

		DoomsdayTechExperiment: {
			DisplayName: 末日科技实验体
			Tooltip:
				'''
				当玩家不发动攻击的时候，每1.5秒增加手持非召唤武器一倍的攻击力
				上限为15秒增加10倍
				“蹲下，屏住呼吸，扣动扳机”
				'''
		}

		FixedPointAttackDevice: {
			DisplayName: 定点进攻装置
			Tooltip:
				'''
				静止移动时能够翻倍输出
				全速移动时降低75%的输出能力
				攻击力变化将会线性增长或降低
				“专门献给老六”
				'''
		}

		OpticalLensMatrix: {
			DisplayName: 复制光学镜
			Tooltip:
				'''
				让非召唤弹幕有概率分裂成多发
				分裂数量越少，每发弹幕伤害越高
				分裂后的弹幕伤害大幅降低且无法继续分裂
				“无比混乱”
				'''
		}

		Annihilation: {
			TheEntropy: {
				DisplayName: 熵蚀者
				Tooltip:
					'''
					生命再生归零，禁用治疗药水，同时每秒开始强制损失一些生命值
					损失的生命值的速度会由快变慢，最终停滞在最大生命值的25%
					弹幕击中敌人后有40%的概率生成一个3倍伤害的复制品
					“你现在应该知道你损失的那些生命值转化成了什么了吧”
					'''
			}

			AntimatterSynthesizer: {
				DisplayName: 反物质合成器
				Tooltip:
					'''
					大幅提升非召唤弹幕的穿透力和飞行速度
					但是玩家的武器有5%概率射出额外的敌对的弹幕
					敌对弹幕从屏幕边缘的随机方向射向玩家
					“小心，他们足以秒杀你”
					'''
			}

			CrownofOblivion: {
				DisplayName: 湮灭之冠
				Tooltip:
					'''
					-----[c/8e44ad:极道灭世]-----
					提升45%近战攻击力和45近战攻击速度
					拥有其所有材料的效果
					大幅提升弹幕的穿透力和飞行速度，但是有概率射出敌对弹幕秒杀玩家（反物质合成器）
					额外受到伤害，但是强制损失敌人的血量（灵魂量子侵蚀者）
					大幅提升战士的进攻性，但受伤时会使防御力与减伤归零（狂战士机械臂）
					玩家血量越低伤害越高（裂变反应炉）
					近战攻速与自己与敌人的距离成反比（白刃腰带）
					血量告急时提供速度与伤害增幅（极限反应模块）
					对于不受攻速加成的近战武器而言，将近战攻速转化为伤害（日轮之旗）
					手动开启一个超大幅度提升伤害，但是代价巨大的技能（超频V型）
					通过饰品可见性来禁用回血并持续损失生命值，但有概率射出伤害极高的复制弹幕（熵蚀者）
					“只有无限接近死亡，才会体验生命的意义”
					'''
			}

			DamageProtectionDevice: {
				DisplayName: 狂战士机械臂
				Tooltip:
					'''
					提升45%近战攻击力和45近战攻击速度
					但是受伤时防御力与伤害减免归零，持续10秒
					“战士，但是活出了射手的样子”
					'''
			}

			FissionReactor: {
				DisplayName: 裂变反应炉
				Tooltip:
					'''
					每损失10%的血量就会提升10%的攻击力
					上限为损失90%的血量提升90%的攻击力
					“事已至此”
					'''
			}

			HeroDamageDevice: {
				DisplayName: 白刃腰带
				Tooltip:
					'''
					距离敌人越近，越会提高近战攻击力和攻速
					距离10格远时会线性提升至50%的攻击力和30的攻速
					远离超过30格会受到负面影响
					最严重的时候会在第60格的地方降低30%的攻击力和30的攻速
					“想拼刀吗？来啊”
					'''
			}

			LimitResponseModule: {
				DisplayName: 极限反应模块
				Tooltip:
					'''
					当血量降低至20%以下时获得伤害、暴击、移动速度提升
					效果自动触发，维持15秒，冷却时间为50秒
					在这之后，再将血量降低至10%以下才能触发
					“肾上腺素让你心跳加速”
					'''
			}

			SolarBanner: {
				DisplayName: 日轮之旗
				Tooltip:
					'''
					对于悠悠球、链枷等近战武器
					能够将近战攻速加成1:1转化为伤害加成
					“你的手臂更有力了，因此这些武器也有了伤害提升，这很合理不是吗”
					'''
			}

			UltimateFunctionOverloadDevice: {
				DisplayName: 超频V型
				Tooltip:
					'''
					按下快捷键消耗自身50%最大生命值，降低50%防御力，50%移动速度
					同时大幅提升仇恨值并且失去视野为代价
					在接下来的15秒提升600%的伤害，冷却时间为1分钟
					效果随时都可以取消
					如果在一个“好世界”里，那么不会遮挡玩家的视野
					“战术核显卡”
					'''
			}

			SoulQuantumCorruptor: {
				DisplayName: 灵魂量子侵蚀者
				Tooltip:
					'''
					每5秒钟让周围的敌人固定损失当前生命值的5%
					但你自己也会额外受到15%的伤害
					“坏到骨子里了”
					'''
			}
		}

		AIAssistDevice: {
			DisplayName: 人工智能穿透装置
			Tooltip:
				'''
				你的弹幕可以穿透方块
				“对于雷管和炸药来说，这显然不是一个好主意，对吧？”
				'''
		}

		SonicRing: {
			DisplayName: 音波环
			Tooltip:
				'''
				在玩家为中心生成2个圆环，在弹幕靠近玩家时，按下快捷键进行一次判定
				当在2个环中间里，Great，会清除敌方弹幕
				在外环外，Miss，会强行进入一秒的冷却
				在内环里面，Perfect，消除弹幕的同时+2%攻击力，最多可叠加50次，直到失败或者被命中
				“未来是人们的归属，而我也需要走向自己的未来”
				【[c/5272e9:专 ][c/c8e553:属 ][c/00c0e6:物 ][c/8e1ad7:品 ]】
				'''
		}

		FallenStar: {
			DisplayName: 落星者
			Tooltip:
				'''
				在夜间地表佩戴时
				从天空随机召唤落星
				“我向天空许愿，天空说彳亍”
				'''
		}
	}

	Defense: {
		OnlyCYC: {
			AedComponents: {
				DisplayName: Aed组件
				Tooltip:
					'''
					每隔4秒生成一个红心在玩家周围，捡到恢复20生命值
					只有当血量低于90%时才会触发这个效果
					“吃啥补啥”
					'''
			}

			BloodPump: {
				DisplayName: 活血泵
				Tooltip:
					'''
					按下绑定按键时立刻恢复已损失生命值的一半
					与此同时给予一个极强的生命回复和伤害减免
					冷却时间30秒，与治疗药水相互独立
					“重获新生”
					'''
			}

			BloodVesselAccelerator: {
				DisplayName: 血管加速器
				Tooltip:
					'''
					生命值低于50%时提升25生命再生速度，低于15%提升100，高于75%归零
					按下快捷键键时，给予一个大幅提升生存能力的效果
					持续时间10秒，冷却时间30秒
					“绝处逢生”
					'''
			}

			HeartPacemaker: {
				DisplayName: 心脏起搏器
				Tooltip:
					'''
					增加15点生命回复
					生命值每损失10%，便会提供10点防御力和5%的伤害减免
					上限为损失90%生命，提供90点防御和45%的伤害减免
					“内心坚固”
					'''
			}

			LifeSubSpace: {
				DisplayName: 生命复苏仪
				Tooltip:
					'''
					当玩家血量不足20%时，自动在原地创建一个治疗光环
					进入光环内的所有玩家都会被清除负面效果并给予极速回血
					这个效果有90秒的冷却时间
					如果升级为循环系统改造套件，那么冷却时间将缩短至45秒
					“冥士追魂”
					'''
			}

			MechanicalHeart: {
				DisplayName: 机械主义心脏
				Tooltip:
					'''
					受到致命伤害是满血复活一次
					给予100的生命恢复和10秒的无敌
					两分半冷却，死亡后立刻重置冷却
					如果在一个“好世界”里，那么冷却会缩短至半分钟
					“秽土重生”
					'''
			}

			PainEditor: {
				DisplayName: 疼痛编辑器
				Tooltip:
					'''
					将单次最大伤害限制在你当前最大生命值的20%
					“永远不死”
					'''
			}

			Z_CirculationSystemRetrofitKit: {
				DisplayName: 循环系统改造套件
				Tooltip:
					'''
					-----[c/2ecc71:生机永恒]-----
					防御力+25，超大幅度提升仇恨值
					拥有其材料的所有效果：
					时不时的掉落红心缓慢回血（AED组件）
					在水下提供全方位数据提升（二氧化碳交换机）
					在受到严重伤害后令下次伤害减半（碳化钨内胆）
					固定降低一些所受伤害（镇静制冷器）
					记录一次伤害并试图回复一定百分比的血量（蜂群构造体）
					手动开启以获得95%的伤害减免持续10秒（血管加速器）
					恢复已损失的生命值的一半并快速回血（活血泵）
					将单次受到的伤害限制在最大生命值的20%（疼痛编辑器）
					血量低时提供更高的防御力和伤害减免（心脏起搏器）
					血量告急时创建快速回血的立场（生命复苏仪）
					血量满时受伤则掉落两倍的红心（主动脉推进器）
					受到致命伤害复活一次（机械主义心脏）
					“生命如春风不止，唯有坚韧才能抵御风霜”
					'''
			}

			SwarmConstruct: {
				DisplayName: 蜂群构造体
				Tooltip:
					'''
					受到伤害时记录下这次伤害
					如果5秒钟之内没有再受到一次伤害的话，则回复这次伤害的10%~70%
					如果持续受到伤害，那么则延长5秒钟的计时器
					“精湛的蜂巢工艺”
					'''
			}

			SedativeRefrigerator: {
				DisplayName: 镇静制冷器
				Tooltip:
					'''
					固定降低（10肉前，15肉后，25花后，40月后）所受伤害
					伤害降低独立于任何防御和伤害减免
					“心静自然凉”
					'''
			}

			CO2Switch: {
				DisplayName: 二氧化碳交换机
				Tooltip:
					'''
					在水下时提供20%的最大生命值、飞行时间和移动速度
					15点生命回复，25点防御力
					在陆地上时不会降低数据
					“放心，不会有减压病”
					'''
			}

			AorticThruster: {
				DisplayName: 主动脉推进器
				Tooltip:
					'''
					血量为满时受到的伤害会转化为2倍的红心随机散落在周围
					冷却时间15秒
					“怎么多了这么多？”
					'''
			}

			TungstenCore: {
				DisplayName: 碳化钨内胆
				Tooltip:
					'''
					防御+15
					一次性受到大于等于最大生命值10%的伤害后激活防护
					下一次伤害减半
					“我铁了心的要保护你”
					'''
			}
		}

		OnlyEMPs: {
			ClearBullet: {
				Absorber15: {
					DisplayName: 15型能量吸收装置
					Tooltip:
						'''
						按下电磁脉冲键时，清除半径15格内的敌方弹幕
						将每一发被清理的弹幕转化为3.5%的临时伤害提升，持续5秒
						冷却时间为45秒
						“没有枪没有炮，敌人给我们造”
						'''
				}

				Interceptor15: {
					DisplayName: 15型弹幕拦截器
					Tooltip:
						'''
						按下电磁脉冲键时，清除半径15格内的敌方弹幕
						冷却时间为45秒
						“消！除！光！线！”
						'''
				}

				Interceptor25II: {
					DisplayName: 25II型弹幕拦截器
					Tooltip:
						'''
						按下电磁脉冲键时，清除半径25格内的敌方弹幕
						同时对范围内的敌人施加一次困惑debuff
						冷却时间为45秒
						“令人感到困惑”
