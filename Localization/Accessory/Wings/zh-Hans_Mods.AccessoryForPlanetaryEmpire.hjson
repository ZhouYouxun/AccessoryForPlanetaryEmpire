Accessory: {
	Wings: {
		IMPWing: {
			DisplayName: 星界动力之翼
			Tooltip:
				'''
				-----[c/27ae60:星动万里]-----
				生命回复，伤害，与防御力各+15
				准许无限飞行
				在空中同时按住上与下键能够让你在空气中如履平地
				拥有其材料的所有效果
				双击左右键或者按下快捷键进行强而有力的冲刺
				冲刺能够造成伤害无敌的同时还能清除敌方弹幕
				按下大冲刺键可以享受极强极远的长距离无敌冲刺
				将自身的修饰与乘以7倍施加在玩家身上
				拥有动力推进装置，疾风行者靴，和折跃启动引擎的效果
				“速度无极限，翱翔天地间，随心所动，万里可至”
				'''
		}
	}
}
