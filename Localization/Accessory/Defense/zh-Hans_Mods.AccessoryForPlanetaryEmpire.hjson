Accessory: {
	Defense: {
		OnlyCYC: {
			AedComponents: {
				DisplayName: Aed组件
				Tooltip:
					'''
					每隔4秒生成一个红心在玩家周围，捡到恢复20生命值
					只有当血量低于90%时才会触发这个效果
					“吃啥补啥”
					'''
			}

			BloodPump: {
				DisplayName: 活血泵
				Tooltip:
					'''
					按下绑定按键时立刻恢复已损失生命值的一半
					与此同时给予一个极强的生命回复和伤害减免
					冷却时间30秒，与治疗药水相互独立
					“重获新生”
					'''
			}

			BloodVesselAccelerator: {
				DisplayName: 血管加速器
				Tooltip:
					'''
					生命值低于50%时提升25生命再生速度，低于15%提升100，高于75%归零
					按下快捷键键时，给予一个大幅提升生存能力的效果
					持续时间10秒，冷却时间30秒
					“绝处逢生”
					'''
			}

			HeartPacemaker: {
				DisplayName: 心脏起搏器
				Tooltip:
					'''
					增加15点生命回复
					生命值每损失10%，便会提供10点防御力和5%的伤害减免
					上限为损失90%生命，提供90点防御和45%的伤害减免
					“内心坚固”
					'''
			}

			LifeSubSpace: {
				DisplayName: 生命复苏仪
				Tooltip:
					'''
					当玩家血量不足20%时，自动在原地创建一个治疗光环
					进入光环内的所有玩家都会被清除负面效果并给予极速回血
					这个效果有90秒的冷却时间
					如果升级为循环系统改造套件，那么冷却时间将缩短至45秒
					“冥士追魂”
					'''
			}

			MechanicalHeart: {
				DisplayName: 机械主义心脏
				Tooltip:
					'''
					受到致命伤害是满血复活一次
					给予100的生命恢复和10秒的无敌
					两分半冷却，死亡后立刻重置冷却
					如果在一个“好世界”里，那么冷却会缩短至半分钟
					“秽土重生”
					'''
			}

			PainEditor: {
				DisplayName: 疼痛编辑器
				Tooltip:
					'''
					将单次最大伤害限制在你当前最大生命值的20%
					“永远不死”
					'''
			}

			Z_CirculationSystemRetrofitKit: {
				DisplayName: 循环系统改造套件
				Tooltip:
					'''
					-----[c/2ecc71:生机永恒]-----
					防御力+25，超大幅度提升仇恨值
					拥有其材料的所有效果：
					时不时的掉落红心缓慢回血（AED组件）
					在水下提供全方位数据提升（二氧化碳交换机）
					在受到严重伤害后令下次伤害减半（碳化钨内胆）
					固定降低一些所受伤害（镇静制冷器）
					记录一次伤害并试图回复一定百分比的血量（蜂群构造体）
					手动开启以获得95%的伤害减免持续10秒（血管加速器）
					恢复已损失的生命值的一半并快速回血（活血泵）
					将单次受到的伤害限制在最大生命值的20%（疼痛编辑器）
					血量低时提供更高的防御力和伤害减免（心脏起搏器）
					血量告急时创建快速回血的立场（生命复苏仪）
					血量满时受伤则掉落两倍的红心（主动脉推进器）
					受到致命伤害复活一次（机械主义心脏）
					“生命如春风不止，唯有坚韧才能抵御风霜”
					'''
			}

			SwarmConstruct: {
				DisplayName: 蜂群构造体
				Tooltip:
					'''
					受到伤害时记录下这次伤害
					如果5秒钟之内没有再受到一次伤害的话，则回复这次伤害的10%~70%
					如果持续受到伤害，那么则延长5秒钟的计时器
					“精湛的蜂巢工艺”
					'''
			}

			SedativeRefrigerator: {
				DisplayName: 镇静制冷器
				Tooltip:
					'''
					固定降低（10肉前，15肉后，25花后，40月后）所受伤害
					伤害降低独立于任何防御和伤害减免
					“心静自然凉”
					'''
			}

			CO2Switch: {
				DisplayName: 二氧化碳交换机
				Tooltip:
					'''
					在水下时提供20%的最大生命值、飞行时间和移动速度
					15点生命回复，25点防御力
					在陆地上时不会降低数据
					“放心，不会有减压病”
					'''
			}

			AorticThruster: {
				DisplayName: 主动脉推进器
				Tooltip:
					'''
					血量为满时受到的伤害会转化为2倍的红心随机散落在周围
					冷却时间15秒
					“怎么多了这么多？”
					'''
			}

			TungstenCore: {
				DisplayName: 碳化钨内胆
				Tooltip:
					'''
					防御+15
					一次性受到大于等于最大生命值10%的伤害后激活防护
					下一次伤害减半
					“我铁了心的要保护你”
					'''
			}
		}

		OnlyEMPs: {
			ClearBullet: {
				Absorber15: {
					DisplayName: 15型能量吸收装置
					Tooltip:
						'''
						按下电磁脉冲键时，清除半径15格内的敌方弹幕
						将每一发被清理的弹幕转化为3.5%的临时伤害提升，持续5秒
						冷却时间为45秒
						“没有枪没有炮，敌人给我们造”
						'''
				}

				Interceptor15: {
					DisplayName: 15型弹幕拦截器
					Tooltip:
						'''
						按下电磁脉冲键时，清除半径15格内的敌方弹幕
						冷却时间为45秒
						“消！除！光！线！”
						'''
				}

				Interceptor25II: {
					DisplayName: 25II型弹幕拦截器
					Tooltip:
						'''
						按下电磁脉冲键时，清除半径25格内的敌方弹幕
						同时对范围内的敌人施加一次困惑debuff
						冷却时间为45秒
						“令人感到困惑”
						'''
				}

				Interceptor35IV: {
					DisplayName: 35IV型弹幕拦截器
					Tooltip:
						'''
						按下电磁脉冲键时，清除半径35格内的敌方弹幕
						同时将周围散射大量激光
						冷却时间为45秒
						“所以说，这打的中谁？”
						'''
				}

				Interceptor45: {
					DisplayName: 45型转化弹幕拦截器
					Tooltip:
						'''
						按下电磁脉冲键时，清除半径55格内的敌方弹幕
						50%将敌方弹幕反转成有方弹幕并原路返回
						冷却时间为45秒
						“离间计并不总是起效，不是吗？”
						'''
				}

				Interceptor55I: {
					DisplayName: 55I型连锁引爆炮
					Tooltip:
						'''
						按下电磁脉冲键时，清除半径55格内的敌方弹幕
						弹幕被清除时会被引爆，对小范围内的敌人造成5倍原弹幕伤害
						冷却时间为45秒
						“强大的堡垒往往从内部破裂”
						'''
				}

				Interceptor55IX: {
					DisplayName: 55IX型转化弹幕拦截器
					Tooltip:
						'''
						按下电磁脉冲键时，清除半径55格内的敌方弹幕
						100%将敌方弹幕反转成有方弹幕并原路返回
						冷却时间为45秒
						“从物质上的反转总是能起效”
						'''
				}

				Interceptor55VI: {
					DisplayName: 55VI型震荡弹射器
					Tooltip:
						'''
						按下电磁脉冲键时，清除半径55格内的敌方弹幕
						同时将范围内的敌人眩晕3秒
						冷却时间为45秒
						“他们修好那些东西的速度简直惊为天人”
						'''
				}
			}

			SupportBullet: {
				Barrier25d: {
					DisplayName: 25d型屏障生成装置
					Tooltip:
						'''
						按下电磁脉冲键时，在原地放置一个半径25格的屏障
						屏障能在存在的10秒钟内阻挡敌人子弹
						冷却时间为30秒
						“你只可到此，不得逾越”
						'''
				}

				SubSpace25e: {
					DisplayName: 25f型超时空场生成装置
					Tooltip:
						'''
						按下电磁脉冲键时，在原地放置一个半径25格的超时空力场
						力场能够在10秒的存在时间内为内部的所有玩家提供无敌
						冷却时间为30秒
						“通过空间压缩与折叠技术产生的超时空力场”
						'''
				}
			}

			UniversalProtectionDevice001: {
				DisplayName: 001型通用舰载全方位防护装置
				Tooltip:
					'''
					-----[c/3498db:护盾天幕]-----
					拥有周期性屏障和能量盾弹射器的效果
					按下电磁脉冲键时，清除半径250格内的敌方弹幕
					弹幕被清除时会引爆，造成10倍原弹幕伤害
					将这些弹幕转化为我方弹幕并原路返回
					被清除的每一发弹幕都会转化为2%的伤害提升和两点防御力持续15秒
					与此同时，在原地留下一个半径90格的屏障为玩家提供无敌，并且阻挡敌方弹幕
					同时还将范围内的所有敌人眩晕10秒
					冷却时间为60秒
					“坚如磐石，护如天幕，绝不让任何伤害透过你”
					'''
			}

			Interceptor65L: {
				DisplayName: 65L型激光弹幕拦截器
				Tooltip:
					'''
					每次按下电磁脉冲键时，清除距离玩家最近的一发敌方弹幕
					每一秒钟装填一次，最大填装150发
					“没关就是开了？”
					'''
			}

			OtherEMP: {
				EnergyShieldCatapult: {
					DisplayName: 能量盾弹射器
					Tooltip:
						'''
						增加15%的伤害减免和跳跃速度
						增加15点防御力
						每隔5秒自动射出一发极其缓慢，但是能够自动消除敌人子弹的圆环状弹幕
						“狐假虎威”
						'''
				}

				PeriodicBarrierBooster: {
					DisplayName: 周期性屏障生成器
					Tooltip:
						'''
						防御力加8
						每隔45秒钟自动提供5秒钟的无敌
						“简单纯粹的无敌”
						“这是本模组第1个加入的装备，非常有历史意义，因此你可以在游戏早期就获得它，这听上去不错！”
						'''
				}
			}
		}

		AsteroidBelt: {
			DisplayName: 小行星杯
			Tooltip:
				'''
				制造一个小行星，围绕你旋转
				它会为你挡下敌人的弹幕
				但是挡下5发弹幕就会破裂一段时间
				“质量好像不是特别好”
				'''
		}

		FixedPointDefenseDevice: {
			DisplayName: 定点防御装置
			Tooltip:
				'''
				静止移动时能够翻倍防御
				全速移动时降低75%的防御能力
				防御力变化将会线性增长或降低
				“缩进甲虫壳中”
				'''
		}

		IntegratedNeuron: {
			DisplayName: 集成神经元
			Tooltip:
				'''
				每秒加速debuff的流失时间30%
				治疗冷却每5秒降低5%
				魔力疾病每1秒降低30%
				“这是因为你有抗体了”
				'''
		}

		ShieldGeneratorOnDeployment: {
			DisplayName: 部署时护盾生成装置
			Tooltip:
				'''
				+8防御力，免疫火块和击退
				在刚复活的时候给予十秒的无敌
				“↑ ↓ → ← ↑”
				'''
		}

		BrassPocketWatch: {
			DisplayName: 黄铜怀表
			Tooltip:
				'''
				提升25%的全职业伤害和10%的全职业暴击
				佩戴者死亡时有概率让这个世界内的所有人一起陪葬
				“他们都被吓死了”
				'''
		}

		Counter: {
			ChargedBulletNest: {
				DisplayName: 蓄力子弹巢
				Tooltip:
					'''
					每受到一次伤害，便会增加6发弹幕
					弹幕上限为150发
					死亡时会将这些弹幕一起射出去
					“装填、旋转、开枪”
					'''
			}

			DarkSideOfTheMoon: {
				DisplayName: 月之暗面
				Tooltip:
					'''
					当生命值小于一半时，每受到3次伤害，便会往周围弹出一大堆能阻挡弹幕的月亮护盾
					护盾持续10秒，阻挡次数无限
					“这是月球领主的法术，它觉得可能会太欺负你于是没有在战斗中使用出来”
					'''
			}

			FirepowerExoskeletonDevice: {
				DisplayName: 火力外骨骼套件
				Tooltip:
					'''
					受到伤害时提升200%攻击力，持续5秒
					只有当伤害大于等于最大生命值的15%才会生效
					冷却时间为15秒
					“打不死我的，只会让我更加强大”
					'''
			}

			MagicSeeker: {
				DisplayName: 魔力引导头
				Tooltip:
					'''
					玩家每受到1次伤害，便能使接下来的10次攻击能够偷取对方生命值
					吸血次数最高可以囤积100次
					偷取生命值不强制需要使用魔法武器
					“医者当然可以自医”
					'''
			}

			NervousSystemDisorderDevice: {
				DisplayName: 神经系统紊乱装置
				Tooltip:
					'''
					每受到2次伤害就能使周围小范围内的敌人降低30%移速和30%攻击力
					这个效果会持续两秒
					“说是能干扰敌人的神经，但这效果本质上也就相当于往他们脸上喷辣椒水”
					'''
			}

			ReactShieldGenerator: {
				DisplayName: 反应护盾生成器
				Tooltip:
					'''
					每受到3次伤害便会提供5秒钟的无敌时间
					“适合连续受击”
					'''
			}

			Scarab: {
				DisplayName: 圣甲虫
				Tooltip:
					'''
					每受到5次伤害时
					令大范围内的敌方弹幕转化为我方弹幕并原路返回
					如果在一个“好世界”里，那么只用受到两次伤害即可
					“像是打碎了什么东西一样”
					'''
			}

			ShinySlimeGun: {
				DisplayName: 粉红史莱姆粘液枪
				Tooltip:
					'''
					每隔5秒往鼠标位置扔出两个闪光粘液盾牌
					护盾持续10秒，阻挡2次数后便会销毁
					“你看，他们像弹珠一样”
					'''
			}

			SlimeGun: {
				DisplayName: 史莱姆粘液枪
				Tooltip:
					'''
					每受到5次伤害，便会在鼠标处往周围弹出一大堆能阻挡弹幕的粘液护盾
					护盾持续10秒，但阻挡1次数后便会销毁
					“你猜他是怎么当上史莱姆王的”
					'''
			}

			ControllableStellarEnergy: {
				DisplayName: 可控恒星能源
				Tooltip:
					'''
					-----[c/00c0e6:恒能触发]-----
					拥有其所有材料的全部效果：
					5次受伤时在鼠标处扔出粘液护盾（史莱姆粘液枪）
					3次受伤时给予5秒无敌（反应护盾）
					5次受伤时反转敌人弹幕（圣甲虫）
					2次受伤时削弱敌人的移速和攻击力（神经系统紊乱装置）
					每次受伤时便能积攒武器吸血次数（魔力引导头）
					每次受伤时都能积攒弹幕，死亡时一起发射（蓄力子弹巢）
					受到足够大的伤害时大幅提升输出能力（火力外骨骼套件）
					不足半血时受到3次伤害时弹出无限阻挡的护盾（月之暗面）
					自动发射粘液护盾（粉红史莱姆粘液枪）
					“世间万物皆有价，尤其是你自己”
					'''
			}
		}
	}
}
