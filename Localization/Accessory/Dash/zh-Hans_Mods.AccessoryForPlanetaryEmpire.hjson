Accessory: {
	Dash: {
		ElfEnergyCore: {
			DisplayName: 精灵能量核心
			Tooltip:
				'''
				进行强而有力的能量冲刺，免疫敌人弹幕伤害
				关闭饰品可见性让它使用左右双击键冲刺
				开启饰品可见性让它使用单键冲刺
				“知道为什么她这么多弹幕了吧”
				'''
		}

		PowerJetPack: {
			DisplayName: 电能喷气背包
			Tooltip:
				'''
				进行极长极远极快的电能冲刺
				冲刺期间免疫一切伤害，并对敌人造成高额碰撞伤害
				冲刺冷却时间为20秒
				“火星科技，压缩冲刺”
				'''
		}

		ShallowOxygenBottle: {
			DisplayName: 浅滩氧气瓶
			Tooltip:
				'''
				进行强而有力的水能冲刺，免疫敌人碰撞伤害
				关闭饰品可见性让它使用左右双击键冲刺
				开启饰品可见性让它使用单键冲刺
				“氧气不会不足”
				'''
		}

		SweetheartCloak: {
			DisplayName: 甜蜜披风
			Tooltip:
				'''
				进行强而有力的蜂蜜冲刺，有25%的概率免疫伤害
				关闭饰品可见性让它使用左右双击键冲刺
				开启饰品可见性让它使用单键冲刺
				“不许奴役蜜蜂”
				'''
		}
	}
}
