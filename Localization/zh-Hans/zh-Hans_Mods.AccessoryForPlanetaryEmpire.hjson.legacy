	ArmyBattleBanner: {
		Tooltip:
			'''
			将你的仆从栏位强制变为1
			每损失的一个仆从栏额外提供120%的召唤伤害增幅
			“不再是军队 现在是保镖了”
			'''
		DisplayName: 军团战旗
	}

	TheOutcast: {
		DisplayName: 逸界者
		Tooltip:
			'''
			喷射改变地形的溶液
			右键切换模式
			不消耗弹药
			“净化世界必备”
			'''
	}

	HolographicSummoningDevice: {
		DisplayName: 全息召唤装置
		Tooltip:
			'''
			召唤你接下来将要面对的boss
			右键切换，可以挑战以前的boss
