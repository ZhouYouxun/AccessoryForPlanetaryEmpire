				Interceptor35IV: {
					DisplayName: 35IV型弹幕拦截器
					Tooltip:
						'''
						按下电磁脉冲键时，清除半径35格内的敌方弹幕
						同时将周围散射大量激光
						冷却时间为45秒
						“所以说，这打的中谁？”
						'''
				}

				Interceptor45: {
					DisplayName: 45型转化弹幕拦截器
					Tooltip:
						'''
						按下电磁脉冲键时，清除半径55格内的敌方弹幕
						50%将敌方弹幕反转成有方弹幕并原路返回
						冷却时间为45秒
						“离间计并不总是起效，不是吗？”
						'''
				}

				Interceptor55I: {
					DisplayName: 55I型连锁引爆炮
					Tooltip:
						'''
						按下电磁脉冲键时，清除半径55格内的敌方弹幕
						弹幕被清除时会被引爆，对小范围内的敌人造成5倍原弹幕伤害
						冷却时间为45秒
						“强大的堡垒往往从内部破裂”
						'''
				}

				Interceptor55IX: {
					DisplayName: 55IX型转化弹幕拦截器
					Tooltip:
						'''
						按下电磁脉冲键时，清除半径55格内的敌方弹幕
						100%将敌方弹幕反转成有方弹幕并原路返回
						冷却时间为45秒
						“从物质上的反转总是能起效”
						'''
				}

				Interceptor55VI: {
					DisplayName: 55VI型震荡弹射器
					Tooltip:
						'''
						按下电磁脉冲键时，清除半径55格内的敌方弹幕
						同时将范围内的敌人眩晕3秒
						冷却时间为45秒
						“他们修好那些东西的速度简直惊为天人”
						'''
				}
			}

			SupportBullet: {
				Barrier25d: {
					DisplayName: 25d型屏障生成装置
					Tooltip:
						'''
						按下电磁脉冲键时，在原地放置一个半径25格的屏障
						屏障能在存在的10秒钟内阻挡敌人子弹
