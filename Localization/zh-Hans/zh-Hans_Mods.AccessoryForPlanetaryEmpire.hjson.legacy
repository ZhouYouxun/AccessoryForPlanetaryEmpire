		/* Tooltip: "\n" */
		// DisplayName: Super Universal Dye
	}

	AntimatterNuclearMissile: {
		DisplayName: 反物质核导弹
		Tooltip:
			'''
			当boss存活时开始装填，装填一枚核导弹需要10分钟的时间
			在这期间，敌人或自己死亡会重新开始装填
			装填完成后立刻发射，杀死所有Boss
			核导弹无视任何防御力、伤害减免、防秒杀机制
			该过程无法被任何手段加速
			“请耐心等待”
			'''
	}

	StarPack: {
		DisplayName: 新手补给箱
		Tooltip: 右键打开
	}

	TamingWhipRing: {
		Tooltip:
			'''
			仆从数量-3，伤害-30%
			但是仆从击中敌人时，能够给予玩家鞭子15%攻速和鞭子50%攻击力加成的buff
			Buff可以叠加7次，最高350%鞭子伤害和105%鞭子攻速
			“You Gotta Move~ You Gotta Move~”
			'''
		DisplayName: 驯兽鞭环
	}

	MedicalDrones: {
		Tooltip:
			'''
			降低45%召唤伤害
			但是每存在一个仆从便会提供25的最大生命值，和5生命回复
			上限为20个仆从提升500最大生命值和100生命恢复
			击中敌人时有30%概率吸血，吸血量取决于仆从造成的伤害的5%~30%
			“你好像饿了”
			'''
		DisplayName: 医疗无人机
	}

	EnergizedChitin: {
		Tooltip:
			'''
			当仆从距离玩家小于25格时有25%概率消除敌方弹幕
			距离玩家超过50格时有50%概率增强我方非召唤弹幕50%伤害
			“敌进我退，敌驻我扰，敌疲我打，敌退我追”
			'''
		DisplayName: 充能几丁质
	}

	SynergisticCatalyst: {
		Tooltip:
			'''
			手持非召唤武器攻击敌人时
			有10%的概率随机提升召唤物面板伤害，持续10秒
