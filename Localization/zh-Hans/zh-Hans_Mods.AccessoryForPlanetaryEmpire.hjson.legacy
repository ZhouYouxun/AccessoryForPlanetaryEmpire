	BulletScreenManagementTerminal: {
		DisplayName: 终级弹幕管理终端
		Tooltip:
			'''
			以下内容仅针对非召唤弹幕			
			弹幕可以必定暴击，穿透物块，提高75%的飞行速度和10的穿透力
			非穿透弹幕不会提升穿透次数
			开关饰品可见性来开关相位投影仪的效果
			按下快捷键在6种弹幕模式中循环切换：
			1 故障：随机触发20多种小故障中的其中一种
			2 引力：围绕玩家自己公转
			3 加速：弹幕速度与伤害随时间指数加速
			4 定位：追杀距离弹幕最近的敌人
			5 回声：弹幕在屏幕边缘反弹并增加伤害
			6 云浮：弹幕随鼠标一起移动
			可以兼容盗贼
			“弹幕只需要按照预定的路线飞行就行了，而我们玩家作为操控者要考虑的可就多了”
			'''
	}

	EchoBoundary: {
		DisplayName: 回声边界
		Tooltip:
			'''
			让你的非召唤弹幕能够在屏幕边缘反弹
			每反弹一次增加15%的伤害
			反弹上限为10次
			“你现在可以带着弹幕一起旅行了”
			'''
	}

	ParticleAccelerator: {
		DisplayName: 精金粒子加速器
		Tooltip:
			'''
			降低非召唤弹幕的初始速度为初始的20%，但让其随时间指数提升
			最大可以提升至弹幕原速度的300%
			弹幕伤害也会由低提升至高，倍率与速度相同
			“1974年，第一次用铬-54离子轰击锇-248”
			'''
	}

	GlitchCore: {
		DisplayName: 故障核心
		Tooltip:
			'''
			让你的非召唤弹幕随机触发各种“小故障”
			小故障有好有坏，抽到什么纯靠运气
			“我才不会告诉你这些是正收益还是负收益”
			'''
	}

	CelestialDominion: {
		DisplayName: 天穹领域
		Tooltip:
			'''
			召唤栏与哨兵栏+10，召唤伤害加80%
			拥有其所有材料的效果
			手持其他职业的武器的时候也能提升召唤能力（协同催化剂）
			与此同时，召唤物有概率射出这种其他职业的弹幕（伊卡鲁斯之礼）
			每持有一个召唤物便会提升最大生命值和生命回复，召唤物能够吸血（医疗无人机）
			召唤物在距离玩家近的时候能够阻挡弹幕，而在距离远的时候能够增强我方弹幕（充能几丁质）
			召唤物击中敌人时给予玩家可堆叠的鞭子增益（驯兽鞭环）
			开启装备可见性将召唤栏与哨兵栏设为1并给予对应的伤害增幅，反之亦然（军团战旗）
			哨兵会跟随玩家移动，而不是站在原地（可控黑洞）
			“你是爽文主角”
			'''
	}
}

