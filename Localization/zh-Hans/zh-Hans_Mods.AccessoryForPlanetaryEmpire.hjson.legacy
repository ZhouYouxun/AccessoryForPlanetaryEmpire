			代价是浪费一个宝贵的饰品栏
			“现代元素使”
			'''
		DisplayName: 混合元素法典
	}

	ArtisansToken: {
		Tooltip:
			'''
			本身不提供加成
			而是将自身的修饰语乘以7倍
			仅支持原版泰拉瑞亚的修饰语
			“那名奸商还挺讲道理的”
			'''
		DisplayName: 工匠令牌
	}

	AttackIndicator: {
		DisplayName: 攻击指示器
