Items: {
	AIAssistDevice: {
		DisplayName: 人工智能穿透装置
		Tooltip:
			'''
			你射出的所有弹幕都能够穿墙
			“对于某些类型的弹幕来说，穿墙可不是什么好消息”
			'''
	}

	FixedPointAttackDevice: {
		DisplayName: 定点进攻装置
		Tooltip:
			'''
			静止移动时能够翻倍输出
			全速移动时降低75%的输出能力
			攻击力变化将会线性增长或降低
			“专门献给老六”
			'''
	}

	HeroDamageDevice: {
		DisplayName: 白刃腰带
		Tooltip:
			'''
			距离敌人越近，越会提高近战攻击力和攻速
			距离10格远时会线性提升至50%的攻击力和30的攻速
			远离超过30格会受到负面影响
			最严重的时候会在第60格的地方降低30%的攻击力和30的攻速
			“想拼刀吗？来啊”
			'''
	}

	ImperialDashShield: {
		DisplayName: 重型冲锋盾牌Mk1
		Tooltip:
			'''
			提升10%伤害，可以进行比较快的四向冲刺
			原版冲刺饰品可能会覆盖此饰品的冲刺效果
			“冲刺！冲刺！”
			'''
	}

	ImperialDashShieldSJR: {
		DisplayName: 重型冲锋盾牌MK2
		Tooltip:
			'''
			提升15%伤害，可以进行非常快的四向冲刺，生命回复加8
			原版冲刺饰品可能会覆盖此饰品的冲刺效果
			“冲刺！冲刺！”
			'''
	}

	UltimateFunctionOverloadDevice: {
		DisplayName: 极限体能超载装置
		Tooltip:
			'''
			消耗自身75%最大生命值为代价，降低50%防御力，50%移动速度，仇恨值大幅提升
			但是在接下来的15秒提升600%的伤害，冷却时间为1分钟
			“玻璃大炮，启动！”
			'''
	}

	UltraHighCrit: {
		DisplayName: 暴击戒指
		Tooltip:
			'''
			玩家的每次攻击都必定暴击(暴击率加100%)，但是防御力减少25%
			“召唤师流下了眼泪”
			'''
	}

	FixedPointDefenseDevice: {
		DisplayName: 定点防御装置
		Tooltip:
			'''
			静止移动时能够翻倍防御
			全速移动时降低75%的防御能力
			防御力变化将会线性增长或降低
			“缩进甲虫壳中”
			'''
	}

	HighVoltageGrid: {
		DisplayName: "高压电网生成器 "
		Tooltip:
			'''
			每隔1.5秒消除范围内的一个敌方弹幕
			“你和你的弹幕让我感到可笑”
			'''
	}

	MagicSeeker: {
		DisplayName: "魔力引导头 "
		Tooltip:
			'''
			受到伤害时将伤害转化为魔力受损，每受5次伤害将会触发一次
			“当一个法师魔力耗尽时：？”
			'''
	}

	PeriodicBarrierBooster: {
		DisplayName: "周期性屏障生成器 "
		Tooltip:
			'''
			防御力加8
			每隔45秒钟自动提供5秒钟的无敌
			“简单纯粹的无敌”
			“这是本模组第1个加入的装备，非常有历史意义，因此你可以在游戏早期就获得它，这听上去不错！”
			'''
	}

	PeriodicBarrierBoosterHAV: {
		DisplayName: "周期性屏障生成器（手动版） "
		Tooltip:
			'''
			防御力加8
			按下绑定按键，激活一个时长为5秒钟的无敌护盾，冷却时间为45秒
			“简单纯粹的无敌”
			'''
	}

	RangeBarrier: {
		DisplayName: "团队范围屏障 "
		Tooltip:
			'''
			按下快捷键，在玩家自身范围为中心，创建一个半径为35格的屏障，仅仅持续1秒钟且阻挡所有敌方弹幕，但冷却时间也只有10秒
			“有点团队，但是不多”
			'''
	}

	ReactShieldGenerator: {
		DisplayName: 反应护盾生成器
		Tooltip:
			'''
			受到伤害时提供5秒钟的无敌时间，每受3次伤害将会触发一次
			“适合连续受击”
			'''
	}

	ReflectArcPulse: {
		DisplayName: 子弹电磁脉冲-清除
		Tooltip:
			'''
			每隔45秒充能后释放反向脉冲清除半径60格以内范围内所有敌方弹幕
			“你的弹幕是多么无趣”
			'''
	}

	ReflectArcPulseHAV: {
		DisplayName: "子弹电磁脉冲-清除（手动版） "
		Tooltip:
			'''
			在45秒的充能时间过后，手动按下快捷键释放反向脉冲清除半径60格范围内所有敌方弹幕
			“你的弹幕是多么无趣”
			'''
	}

