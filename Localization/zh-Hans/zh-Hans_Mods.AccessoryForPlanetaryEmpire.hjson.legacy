			“知己知彼，方能百战不怡”
			'''
		DisplayName: 协同催化剂
	}

	GiftofLcarus: {
		DisplayName: 伊卡鲁斯的礼物
		Tooltip:
			'''
			增加3仆从栏和3哨兵栏，30%的召唤伤害
			手持其他职业武器时有40%的概率让仆从、哨兵射出当前手持武器的弹幕
			注：部分特殊攻击动画的武器可能不起作用[i:2795][i:675]
			“给你的军队换上更好的武装！”
			'''
	}

	HandheldBlackHole: {
		DisplayName: 可控引力发生器
		Tooltip:
			'''
			增加2哨兵栏
			让哨兵能够跟随玩家进行移动，而不是待在原地
			“移动堡垒！”
			'''
