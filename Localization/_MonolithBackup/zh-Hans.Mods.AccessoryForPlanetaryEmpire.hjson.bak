						'''
				}
			}

			UniversalProtectionDevice001: {
				DisplayName: 001型通用舰载全方位防护装置
				Tooltip:
					'''
					-----[c/3498db:护盾天幕]-----
					拥有周期性屏障和能量盾弹射器的效果
					按下电磁脉冲键时，清除半径250格内的敌方弹幕
					弹幕被清除时会引爆，造成10倍原弹幕伤害
					将这些弹幕转化为我方弹幕并原路返回
					被清除的每一发弹幕都会转化为2%的伤害提升和两点防御力持续15秒
					与此同时，在原地留下一个半径90格的屏障为玩家提供无敌，并且阻挡敌方弹幕
					同时还将范围内的所有敌人眩晕10秒
					冷却时间为60秒
					“坚如磐石，护如天幕，绝不让任何伤害透过你”
					'''
			}

			Interceptor65L: {
				DisplayName: 65L型激光弹幕拦截器
				Tooltip:
					'''
					每次按下电磁脉冲键时，清除距离玩家最近的一发敌方弹幕
					每一秒钟装填一次，最大填装150发
					“没关就是开了？”
					'''
			}

			OtherEMP: {
				EnergyShieldCatapult: {
					DisplayName: 能量盾弹射器
					Tooltip:
						'''
						增加15%的伤害减免和跳跃速度
						增加15点防御力
						每隔5秒自动射出一发极其缓慢，但是能够自动消除敌人子弹的圆环状弹幕
						“狐假虎威”
						'''
				}

				PeriodicBarrierBooster: {
					DisplayName: 周期性屏障生成器
					Tooltip:
						'''
						防御力加8
						每隔45秒钟自动提供5秒钟的无敌
						“简单纯粹的无敌”
						“这是本模组第1个加入的装备，非常有历史意义，因此你可以在游戏早期就获得它，这听上去不错！”
						'''
				}
			}
		}

		AsteroidBelt: {
			DisplayName: 小行星杯
			Tooltip:
				'''
				制造一个小行星，围绕你旋转
				它会为你挡下敌人的弹幕
				但是挡下5发弹幕就会破裂一段时间
				“质量好像不是特别好”
				'''
		}

		FixedPointDefenseDevice: {
			DisplayName: 定点防御装置
			Tooltip:
				'''
				静止移动时能够翻倍防御
				全速移动时降低75%的防御能力
				防御力变化将会线性增长或降低
				“缩进甲虫壳中”
				'''
		}

		IntegratedNeuron: {
			DisplayName: 集成神经元
			Tooltip:
				'''
				每秒加速debuff的流失时间30%
				治疗冷却每5秒降低5%
				魔力疾病每1秒降低30%
				“这是因为你有抗体了”
				'''
		}

		ShieldGeneratorOnDeployment: {
			DisplayName: 部署时护盾生成装置
			Tooltip:
				'''
				+8防御力，免疫火块和击退
				在刚复活的时候给予十秒的无敌
				“↑ ↓ → ← ↑”
				'''
		}

		BrassPocketWatch: {
			DisplayName: 黄铜怀表
			Tooltip:
				'''
				提升25%的全职业伤害和10%的全职业暴击
				佩戴者死亡时有概率让这个世界内的所有人一起陪葬
				“他们都被吓死了”
				'''
		}

		Counter: {
			ChargedBulletNest: {
				DisplayName: 蓄力子弹巢
				Tooltip:
					'''
					每受到一次伤害，便会增加6发弹幕
					弹幕上限为150发
					死亡时会将这些弹幕一起射出去
					“装填、旋转、开枪”
					'''
			}

			DarkSideOfTheMoon: {
				DisplayName: 月之暗面
				Tooltip:
					'''
					当生命值小于一半时，每受到3次伤害，便会往周围弹出一大堆能阻挡弹幕的月亮护盾
					护盾持续10秒，阻挡次数无限
					“这是月球领主的法术，它觉得可能会太欺负你于是没有在战斗中使用出来”
					'''
			}

			FirepowerExoskeletonDevice: {
				DisplayName: 火力外骨骼套件
				Tooltip:
					'''
					受到伤害时提升200%攻击力，持续5秒
					只有当伤害大于等于最大生命值的15%才会生效
					冷却时间为15秒
					“打不死我的，只会让我更加强大”
					'''
			}

			MagicSeeker: {
				DisplayName: 魔力引导头
				Tooltip:
					'''
					玩家每受到1次伤害，便能使接下来的10次攻击能够偷取对方生命值
					吸血次数最高可以囤积100次
					偷取生命值不强制需要使用魔法武器
					“医者当然可以自医”
					'''
			}

			NervousSystemDisorderDevice: {
				DisplayName: 神经系统紊乱装置
				Tooltip:
					'''
					每受到2次伤害就能使周围小范围内的敌人降低30%移速和30%攻击力
					这个效果会持续两秒
					“说是能干扰敌人的神经，但这效果本质上也就相当于往他们脸上喷辣椒水”
					'''
			}

			ReactShieldGenerator: {
				DisplayName: 反应护盾生成器
				Tooltip:
					'''
					每受到3次伤害便会提供5秒钟的无敌时间
					“适合连续受击”
					'''
			}

			Scarab: {
				DisplayName: 圣甲虫
				Tooltip:
					'''
					每受到5次伤害时
					令大范围内的敌方弹幕转化为我方弹幕并原路返回
					如果在一个“好世界”里，那么只用受到两次伤害即可
					“像是打碎了什么东西一样”
					'''
			}

			ShinySlimeGun: {
				DisplayName: 粉红史莱姆粘液枪
				Tooltip:
					'''
					每隔5秒往鼠标位置扔出两个闪光粘液盾牌
					护盾持续10秒，阻挡2次数后便会销毁
					“你看，他们像弹珠一样”
					'''
			}

			SlimeGun: {
				DisplayName: 史莱姆粘液枪
				Tooltip:
					'''
					每受到5次伤害，便会在鼠标处往周围弹出一大堆能阻挡弹幕的粘液护盾
					护盾持续10秒，但阻挡1次数后便会销毁
					“你猜他是怎么当上史莱姆王的”
					'''
			}

			ControllableStellarEnergy: {
				DisplayName: 可控恒星能源
				Tooltip:
					'''
					-----[c/00c0e6:恒能触发]-----
					拥有其所有材料的全部效果：
					5次受伤时在鼠标处扔出粘液护盾（史莱姆粘液枪）
					3次受伤时给予5秒无敌（反应护盾）
					5次受伤时反转敌人弹幕（圣甲虫）
					2次受伤时削弱敌人的移速和攻击力（神经系统紊乱装置）
					每次受伤时便能积攒武器吸血次数（魔力引导头）
					每次受伤时都能积攒弹幕，死亡时一起发射（蓄力子弹巢）
					受到足够大的伤害时大幅提升输出能力（火力外骨骼套件）
					不足半血时受到3次伤害时弹出无限阻挡的护盾（月之暗面）
					自动发射粘液护盾（粉红史莱姆粘液枪）
					“世间万物皆有价，尤其是你自己”
					'''
			}
		}
	}

