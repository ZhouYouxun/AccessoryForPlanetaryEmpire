			“这也许才是激光武器的真正用法吧”
			'''
	}

	UniversalProtectionDevice001: {
		DisplayName: 001型通用舰载全方位防护装置
		Tooltip:
			'''
			按下电磁脉冲键时，清除半径250格内的敌方弹幕
			弹幕被清除时会引爆，造成10倍原弹幕伤害
			将这些弹幕转化为我方弹幕并原路返回
			被清除的每一发弹幕都会转化为2%的伤害提升和两点防御力持续15秒
			与此同时，在原地留下一个半径90格的屏障为玩家提供无敌，并且阻挡敌方弹幕
			同时还将范围内的所有敌人眩晕10秒
			冷却时间为60秒
			“这种全能拦截装置一般只会出现在核心母舰上”
			'''
	}

	Kong: {
		DisplayName: 空空枪
		Tooltip:
			'''
			左键使敌人缩小
			右键使敌人变大
			仅供娱乐！
			“空即是色”			
			'''
	}

	SU_ArmyBattleBanner: {
		Tooltip:
			'''
			将你的仆从栏位强制变为1
			每损失的一个仆从栏额外提供120%的召唤伤害增幅
			“不再是军队 现在是保镖了”
			'''
		DisplayName: 军团战旗
	}

	PhaseProjector: {
		DisplayName: 相位投影仪
