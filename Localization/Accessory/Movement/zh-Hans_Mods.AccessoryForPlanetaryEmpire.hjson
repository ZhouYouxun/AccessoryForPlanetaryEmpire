Accessory: {
	Movement: {
		SpeedModActive: {
			DisplayName: 动力推进装置
			Tooltip:
				'''
				移动速度、跳跃速度、下落速度各增加30%，但是防御力减少20%
				按下快捷键将上述三个增益扩张到两倍
				“太快了，等等我”
				冷却时间60秒
				'''
		}

		SwiftWindWalkerBoots: {
			DisplayName: 疾风行者靴
			Tooltip:
				'''
				开启技能之后，在10秒内移动速度大幅提升且无敌
				冷却时间为45秒
				代价是无法造成伤害
				“你跑得越慢，跑得越快”
				'''
		}

		Teleportation: {
			DisplayName: 折跃启动引擎
			Tooltip:
				'''
				按下快捷键，到达鼠标所在的地方
				抵达时清除范围半径15格以内的所有敌方弹幕
				[c/9b59b6:不会造成混沌减益]
				冷却时间为15秒
				“这是哪里来的科技？”
				'''
		}
	}
}
